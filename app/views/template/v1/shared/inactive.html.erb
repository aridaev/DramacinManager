<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= current_instance.display_name %></title>
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: #0e0f13; color: #e7e8ee; }
    .box { text-align: center; padding: 32px; max-width: 420px; }
    h1 { font-size: 1.3rem; margin: 0 0 8px; } p { color: #9a9db0; margin: 0; }
  </style>
</head>
<body><div class="box"><h1><%= current_instance.display_name %></h1><p><%= t("template.v1.inactive_text") %></p></div></body>
</html>
