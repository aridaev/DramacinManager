<% if show_ads? %>
  <% inst = current_instance; href = inst.ads_button_href; img = inst.ads_image_url.presence %>
  <% ad_title = inst.localized("ads_title"); ad_text = inst.localized("ads_text"); ad_btn = inst.localized("ads_button_text") %>
  <div class="player-ad <%= 'has-img' if img %>" id="tv1-ad" data-seconds="<%= inst.ads_seconds %>" data-countdown="<%= t("ads.countdown", n: "{n}") %>" role="dialog" aria-label="<%= t("ads.label") %>">
    <% if img %><div class="player-ad-bg" style="background-image:url('<%= j img %>')" aria-hidden="true"></div><% end %>
    <span class="player-ad-tag"><%= t("ads.label") %></span>
    <div class="player-ad-count" id="tv1-ad-count"><%= t("ads.countdown", n: inst.ads_seconds) %></div>
    <div class="player-ad-inner">
      <% if img %>
        <div class="player-ad-media">
          <% if href %><a href="<%= href %>" target="_blank" rel="nofollow sponsored noopener"><img src="<%= img %>" alt="<%= ad_title %>" loading="eager" referrerpolicy="no-referrer"></a>
          <% else %><img src="<%= img %>" alt="<%= ad_title %>" loading="eager" referrerpolicy="no-referrer"><% end %>
        </div>
      <% end %>
      <div class="player-ad-body">
        <% if ad_title.present? %><h3><%= ad_title %></h3><% end %>
        <% if ad_text.present? %><p><%= ad_text.to_s.strip.gsub(/\s+/, " ") %></p><% end %>
        <div class="player-ad-actions">
          <% if href %><a class="btn player-ad-btn" href="<%= href %>" target="_blank" rel="nofollow sponsored noopener"><%= ad_btn.presence || t("ads.button_default") %></a><% end %>
          <% if inst.members_enabled? %><a class="player-ad-cta" href="<%= template_v1_member_path %>"><%= tt("members.ad_cta") %></a><% end %>
        </div>
        <% if adfree_nav? %><div class="player-ad-share"><%= render "template/v1/shared/share", compact: true %></div><% end %>
      </div>
    </div>
  </div>
<% end %>
