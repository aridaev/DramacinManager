<article class="card">
  <%= link_to tv1_drama_path(drama), class: "card-link-overlay", aria: { label: t("template.v1.card.open", title: drama.title) } do %><% end %>
  <div class="poster-wrap">
    <% if (ep = tv1_episode_label(drama)) %><div class="episode-badge"><%= ep %></div><% end %>
    <% if drama.rating %><div class="rating-badge">★ <%= drama.rating %></div><% end %>
    <%= tv1_poster(drama, lazy: local_assigns.fetch(:lazy, true)) %>
    <%= link_to tv1_watch_path(drama, 1), class: "card-play", aria: { label: t("template.v1.hero.watch_now") } do %>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    <% end %>
    <% if drama.genres.any? %>
      <div class="poster-tags">
        <% drama.genres.first(3).each do |g| %>
          <%= link_to "##{g}", template_v1_genre_path(g.parameterize), class: "movie-tag" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="body">
    <h3 class="title"><%= drama.title %></h3>
    <div class="movie-meta-line"><%= [ drama.language, drama.year ].compact_blank.join(" · ") %></div>
  </div>
</article>
