  <%= link_to template_v1_latest_path, class: ["mtab", ("is-active" if current_page?(template_v1_latest_path))] do %><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M13 3 4 14h7l-1 7 9-11h-7z"/></svg><span><%= tt("mtabs.latest") %></span><% end %>
