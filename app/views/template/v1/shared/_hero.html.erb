<section class="hero" aria-label="<%= t('template.v1.hero.label') %>">
  <div class="hero-track" id="hero-track">
    <% items.each_with_index do |drama, i| %>
      <article class="hero-card">
        <%= link_to tv1_drama_path(drama), class: "hero-poster-link", aria: { label: t("template.v1.card.open", title: drama.title) } do %>
          <%= tv1_poster(drama, lazy: i > 2) %>
        <% end %>
        <div class="hero-pane">
          <h2 class="hero-title"><%= link_to drama.title, tv1_drama_path(drama) %></h2>
          <p class="hero-facts">
            <% if (ep = tv1_episode_label(drama)) %><span class="fact-ep"><%= ep %></span><% end %>
            <% drama.genres.first(2).each do |g| %><span><%= g %></span><% end %>
          </p>
          <% if drama.synopsis.present? %><p class="hero-desc"><%= drama.synopsis %></p><% end %>
          <div class="hero-acts">
            <%= link_to tv1_watch_path(drama, 1), class: "btn" do %>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <span><%= t("template.v1.hero.watch_now") %></span>
            <% end %>
            <%= link_to t("template.v1.hero.details"), tv1_drama_path(drama), class: "btn btn-ghost" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
  <button type="button" class="hero-nav hero-prev" data-hero-nav="prev" aria-label="<%= t('template.v1.hero.prev') %>">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
  </button>
  <button type="button" class="hero-nav hero-next" data-hero-nav="next" aria-label="<%= t('template.v1.hero.next') %>">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
  </button>
</section>
