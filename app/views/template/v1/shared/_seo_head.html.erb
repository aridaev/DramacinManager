<% seo_title = tv1_seo_title; seo_desc = tv1_seo_description; seo_canon = tv1_canonical_url; seo_img = tv1_seo_image %>
    <title><%= seo_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= seo_desc %>">
    <meta name="keywords" content="<%= tv1_keywords.join(", ") %>">
    <% if on_instance_host? && controller_name != "members" %>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow">
    <% else %>
    <meta name="robots" content="noindex, nofollow">
    <% end %>
    <link rel="canonical" href="<%= seo_canon %>">
    <% if on_instance_host? %><link rel="sitemap" type="application/xml" href="<%= request.base_url %>/sitemap.xml"><% end %>
    <% if (gsc = current_instance&.gsc_verification.presence) %><meta name="google-site-verification" content="<%= gsc %>"><% end %>
    <% if (bing = current_instance&.bing_verification.presence) %><meta name="msvalidate.01" content="<%= bing %>"><% end %>
    <meta property="og:type" content="<%= %w[detail watch].include?(tv1_seo_page) ? "video.tv_show" : "website" %>">
    <meta property="og:site_name" content="<%= tv1_site_name %>">
    <meta property="og:title" content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_desc %>">
    <meta property="og:url" content="<%= seo_canon %>">
    <meta property="og:image" content="<%= seo_img %>">
    <meta property="og:locale" content="<%= I18n.locale == :en ? "en_US" : "id_ID" %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seo_title %>">
    <meta name="twitter:description" content="<%= seo_desc %>">
    <meta name="twitter:image" content="<%= seo_img %>">
    <script type="application/ld+json"><%= tv1_seo_jsonld.html_safe %></script>
