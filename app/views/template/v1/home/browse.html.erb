<% heading = @heading || (@query ? t("template.v1.browse.search_title", query: @query) : t("template.v1.browse.genre_title", genre: t("template.v1.genres.#{@genre}", default: @genre.to_s.titleize))) %>
<% content_for :title, tv1_page_title(heading, current_provider.name) %>

<section class="section" style="margin-top:24px">
  <div class="section-head">
    <div>
      <p class="eyebrow"><%= current_provider.name %></p>
      <h1 class="section-title"><%= heading %></h1>
    </div>
  </div>

  <div class="list-toolbar">
    <%= link_to t("template.v1.browse.back_home"), template_v1_root_path, class: "btn btn-outline btn-sm" %>
    <%= render "template/v1/shared/pager", page: @result.page, has_more: @result.has_more %>
  </div>

  <% if @result.items.empty? %>
    <div class="empty-state">
      <h2><%= t("template.v1.empty.title") %></h2>
      <p><%= @query.present? ? t("template.v1.empty.search", query: @query) : t("template.v1.empty.generic") %></p>
    </div>
  <% else %>
    <div class="grid">
      <% @result.items.each do |drama| %>
        <%= render "template/v1/shared/card", drama: drama %>
      <% end %>
    </div>
    <div class="list-toolbar" style="justify-content:flex-end">
      <%= render "template/v1/shared/pager", page: @result.page, has_more: @result.has_more %>
    </div>
  <% end %>
</section>

<%= render "template/v1/shared/seo_page_text" %>
