<% content_for :title, tv1_page_title(current_provider.name) %>
<% all_items = @sections.flat_map(&:items).uniq { |d| d.id } %>

<% if @hero.any? %>
  <section class="banner" id="tv3-banner" aria-label="<%= tt('hero.label') %>">
    <div class="banner-track">
      <% @hero.first(6).each_with_index do |drama, i| %>
        <article class="banner-slide">
          <%= link_to tv1_drama_path(drama), class: "banner-link" do %>
            <span class="banner-bg"><%= tv1_poster(drama, css_class: "banner-bg-img", lazy: i > 0) %></span>
            <span class="banner-poster"><%= tv1_poster(drama, lazy: i > 0) %></span>
            <span class="banner-text">
              <span class="tag tag-hot"><%= tt("tags.hot") %></span>
              <strong class="banner-title"><%= drama.title %></strong>
              <span class="banner-sub"><%= [ tv1_episode_label(drama), drama.genres.first(2).join(" / ") ].compact_blank.join(" · ") %></span>
              <span class="banner-desc"><%= drama.synopsis.presence&.truncate(140) || tt("hero.fallback_desc", title: drama.title) %></span>
              <span class="btn btn-primary"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg><%= tt("hero.play_now") %></span>
            </span>
          <% end %>
        </article>
      <% end %>
    </div>
    <button type="button" class="banner-arrow is-prev" data-banner-nav="prev" aria-label="<%= tt('hero.prev') %>">‹</button>
    <button type="button" class="banner-arrow is-next" data-banner-nav="next" aria-label="<%= tt('hero.next') %>">›</button>
    <div class="banner-dots"><% @hero.first(6).each_with_index do |_, i| %><button type="button" class="banner-dot <%= 'is-on' if i.zero? %>" aria-label="<%= i + 1 %>"></button><% end %></div>
  </section>
<% end %>

<% if @sections.empty? %>
  <div class="empty-state"><h2><%= tt("empty.title") %></h2><p><%= tt("empty.home", provider: current_provider.name) %></p></div>
<% end %>

<% @sections.each_with_index do |section, i| %>
  <% if i.zero? %>
    <%# Modul 1: kartu landscape (gaya MangoTV) %>
    <section class="module" data-rail>
      <div class="module-head"><h2 class="module-title"><%= tt("sections.hot_now") %></h2><div class="rail-ctl"><%= link_to tt("sections.more"), template_v1_latest_path, class: "module-more" %><button type="button" class="rail-arrow" data-rail-nav="prev" aria-label="prev">‹</button><button type="button" class="rail-arrow" data-rail-nav="next" aria-label="next">›</button></div></div>
      <div class="rail-track">
        <% section.items.first(12).each_with_index do |drama, j| %><%= render "template/v3/shared/card", drama: drama, wide: true, hot: j < 3, lazy: j > 3 %><% end %>
      </div>
    </section>

    <%# Ranking "Top 10" %>
    <% ranked = (all_items.drop(12) + all_items).uniq { |d| d.id }.first(10) %>
    <% if ranked.size >= 4 %>
      <section class="module">
        <div class="module-head"><h2 class="module-title"><%= tt("sections.ranking") %></h2><%= link_to tt("sections.more"), template_v1_latest_path, class: "module-more" %></div>
        <ol class="rank-list">
          <% ranked.each_with_index do |drama, n| %>
            <li><%= link_to tv1_drama_path(drama), class: "rank-link" do %><span class="rank-num"><%= n + 1 %></span><span class="rank-poster"><%= tv1_poster(drama) %></span><span class="rank-body"><strong><%= drama.title %></strong><small><%= [ tv1_episode_label(drama), drama.genres.first ].compact_blank.join(" · ") %></small></span><% end %></li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <% if @sections.size == 1 && all_items.size > 12 %>
      <section class="module" data-lazy-section>
        <div class="module-head"><h2 class="module-title"><%= tt("sections.latest") %></h2><span class="module-count"><%= tt("sections.count", count: all_items.size) %></span></div>
        <div class="grid"><% all_items.first(24).each do |drama| %><%= render "template/v3/shared/card", drama: drama %><% end %></div>
        <% if all_items.size > 24 %>
          <template data-more-items><% all_items.drop(24).each do |drama| %><%= render "template/v3/shared/card", drama: drama %><% end %></template>
          <div class="section-more"><button type="button" class="btn btn-outline" data-load-more><%= tt("browse.load_more", count: all_items.size - 24) %></button></div>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <% body = capture do %>
      <section class="module" data-lazy-section>
        <div class="module-head"><h2 class="module-title"><%= section.title.presence || tt("sections.default") %></h2><span class="module-count"><%= tt("sections.count", count: section.items.size) %></span></div>
        <div class="grid">
          <% section.items.first(12).each do |drama| %><%= render "template/v3/shared/card", drama: drama %><% end %>
        </div>
        <% if section.items.size > 12 %>
          <template data-more-items><% section.items.drop(12).each do |drama| %><%= render "template/v3/shared/card", drama: drama %><% end %></template>
          <div class="section-more"><button type="button" class="btn btn-outline" data-load-more><%= tt("browse.load_more", count: section.items.size - 12) %></button></div>
        <% end %>
      </section>
    <% end %>
    <% if i == 1 %><%= body %><% else %><div class="lazy-slot" data-lazy-slot aria-busy="true"><template><%= body %></template><div class="lazy-skeleton"><span></span><span></span><span></span><span></span><span></span><span></span></div></div><% end %>
  <% end %>
<% end %>

<section class="module">
  <div class="module-head"><h2 class="module-title"><%= tt("sections.by_genre") %></h2><%= link_to tt("sections.more"), template_v1_genres_path, class: "module-more" %></div>
  <div class="genre-chips"><% ::Template::V1::BaseController::GENRES.each do |g| %><%= link_to t("template.v1.genres.#{g}", default: g.titleize), template_v1_genre_path(g), class: "genre-chip" %><% end %></div>
</section>

<% if params[:provider].present? %><%= render "template/v1/shared/seo_page_text" %><% end %>
<%= render "template/v1/shared/seo_content" %>
