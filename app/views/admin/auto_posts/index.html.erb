<% content_for :page_actions do %>
  <%= link_to edit_admin_instance_path(@instance, anchor: "sec-autopost"), class: "btn btn-sm btn-secondary" do %><%= dm_icon("box", size: 16) %> <%= t("admin.auto_post.back_to_instance") %><% end %>
  <%= link_to admin_instances_path, class: "btn btn-sm btn-secondary" do %><%= dm_icon("grid", size: 16) %> <%= t("admin.instances.title") %><% end %>
<% end %>
<%= render layout: "shared/app_shell", locals: { title: t("admin.auto_post.page_title", name: @instance.display_name), subtitle: t("admin.auto_post.page_subtitle") } do %>

  <% dead = @auto_posts.count(&:cookie_dead?) %>
  <div class="stats">
    <div class="stat"><span class="stat-label"><%= t("admin.auto_post.stat_accounts") %></span><span class="stat-num"><%= @auto_posts.size %></span></div>
    <div class="stat is-ok"><span class="stat-label"><%= t("admin.auto_post.stat_enabled") %></span><span class="stat-num"><%= @auto_posts.count(&:enabled?) %></span></div>
    <div class="stat <%= 'is-bad' if dead.positive? %>"><span class="stat-label"><%= t("admin.auto_post.stat_dead") %></span><span class="stat-num"><%= dead %></span></div>
    <div class="stat"><span class="stat-label"><%= t("admin.auto_post.stat_posts") %></span><span class="stat-num"><%= @auto_posts.sum(&:posts_count) %></span></div>
    <% nxt = @auto_posts.filter_map(&:next_run_at).min %>
    <div class="stat"><span class="stat-label"><%= t("admin.auto_post.stat_next") %></span><span class="stat-num" style="font-size:1rem"><%= nxt ? l(nxt, format: :short) : "—" %></span></div>
  </div>

  <%# ---------- Tambah akun ---------- %>
  <div class="card">
    <div class="card-head"><h2><%= t("admin.auto_post.add_title") %></h2><span class="muted" style="font-size:.76rem"><%= t("admin.auto_post.add_hint") %></span></div>
    <%= form_with url: admin_instance_auto_posts_path(@instance), method: :post, data: { turbo: false } do %>
      <div class="ap-cookie-row">
        <input type="text" name="auto_post[label]" placeholder="<%= t("admin.auto_post.cookie_label_ph") %>" class="nav-in" maxlength="60">
        <textarea name="auto_post[cookie]" rows="2" placeholder="<%= t("admin.auto_post.cookie_ph") %>" class="ap-cookie-in" required></textarea>
        <button type="submit" class="btn btn-sm"><%= t("admin.auto_post.cookie_add") %></button>
      </div>
      <% if @auto_posts.any? %><p class="muted" style="font-size:.74rem;margin:8px 0 0"><%= t("admin.auto_post.add_copy_hint", label: @auto_posts.last.label) %></p><% end %>
    <% end %>
  </div>

  <% if @auto_posts.empty? %>
    <div class="card"><p class="muted"><%= t("admin.auto_post.empty") %></p></div>
  <% else %>
  <%# ---------- Tabel akun: satu form, Simpan semua ---------- %>
  <div class="card" id="ap-table-card" data-dramas-url="<%= dramas_admin_instance_auto_posts_path(@instance) %>">
    <%= form_with url: bulk_update_admin_instance_auto_posts_path(@instance), method: :patch, id: "ap-bulk", data: { turbo: false } do %>
      <div class="ap-toolbar">
        <div>
          <h2 style="margin:0"><%= t("admin.auto_post.table_title") %></h2>
          <span class="muted" style="font-size:.74rem"><%= t("admin.auto_post.table_hint") %></span>
        </div>
        <button type="submit" class="btn btn-sm"><%= dm_icon("check", size: 14) %> <%= t("admin.auto_post.save_all") %></button>
      </div>
      <div class="table-wrap">
        <table class="table ap-table">
          <thead>
            <tr>
              <th><%= t("admin.auto_post.col_on") %> <button type="button" class="fill-btn" data-fill="enabled" title="<%= t("admin.auto_post.fill_hint") %>">⇩</button></th>
              <th><%= t("admin.auto_post.col_account") %></th>
              <th><%= t("admin.auto_post.col_title") %> <button type="button" class="fill-btn" data-fill="auto_title,episodes_per_title" title="<%= t("admin.auto_post.fill_hint") %>">⇩</button></th>
              <th><%= t("admin.auto_post.f_genres") %> <button type="button" class="fill-btn" data-fill="genres" title="<%= t("admin.auto_post.fill_hint") %>">⇩</button></th>
              <th><%= t("admin.auto_post.col_interval") %> <button type="button" class="fill-btn" data-fill="interval_minutes" title="<%= t("admin.auto_post.fill_hint") %>">⇩</button></th>
              <th><%= t("admin.auto_post.col_max") %> <button type="button" class="fill-btn" data-fill="max_seconds" title="<%= t("admin.auto_post.fill_hint") %>">⇩</button></th>
              <th><%= t("admin.auto_post.col_fx") %> <button type="button" class="fill-btn" data-fill="remix,bgm" title="<%= t("admin.auto_post.fill_hint") %>">⇩</button></th>
              <th><%= t("admin.auto_post.col_status") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @auto_posts.each do |ap| %>
              <% n = "auto_posts[#{ap.id}]" %>
              <tr id="ap-<%= ap.id %>" class="ap-row <%= 'is-dead' if ap.cookie_dead? %>" data-ap="<%= ap.id %>">
                <td><input type="hidden" name="<%= n %>[enabled]" value="0"><input type="checkbox" name="<%= n %>[enabled]" value="1" data-f="enabled" <%= "checked" if ap.enabled? %> title="<%= t("admin.auto_post.f_enabled") %>"></td>
                <td>
                  <input type="text" name="<%= n %>[label]" value="<%= ap.label %>" class="nav-in ap-in" maxlength="60" style="width:130px">
                  <div class="ap-sub">
                    <% if ap.username.present? %><a href="https://instagram.com/<%= ap.username %>" target="_blank" rel="noopener">@<%= ap.username %></a> · <% end %>
                    <%= t("admin.auto_post.progress_short", posts: ap.posts_count, ep: ap.last_episode || "—") %><%= " P#{ap.last_part}/#{ap.parts_total}" if ap.parts_total.to_i > 1 %>
                    <% if ap.next_run_at %> · <%= l(ap.next_run_at, format: :short) %><% end %>
                  </div>
                </td>
                <td>
                  <label class="ap-check"><input type="hidden" name="<%= n %>[auto_title]" value="0"><input type="checkbox" name="<%= n %>[auto_title]" value="1" data-f="auto_title" <%= "checked" if ap.auto_title? %>> <%= t("admin.auto_post.col_auto") %></label>
                  <input type="number" name="<%= n %>[episodes_per_title]" value="<%= ap.episodes_per_title %>" data-f="episodes_per_title" min="<%= AutoPost::MIN_EPISODES_PER_TITLE %>" max="<%= AutoPost::MAX_EPISODES_PER_TITLE %>" step="1" class="nav-in ap-in" style="width:56px" title="<%= t("admin.auto_post.f_episodes_per_title") %>">
                  <div class="ap-sub" title="<%= ap.drama_title %>"><%= ap.provider&.name %><%= " · " if ap.provider && ap.drama_title.present? %><%= ap.drama_title.to_s.truncate(28) %><% if ap.auto_title? && ap.drama_id.present? %> (<%= ap.title_episodes %>/<%= ap.episodes_per_title %>)<% end %><% if ap.auto_title? && ap.posted_titles.any? %> · <%= t("admin.auto_post.titles_done", n: ap.posted_titles.size) %><% end %></div>
                </td>
                <td><input type="text" name="<%= n %>[genres]" value="<%= ap.genres %>" data-f="genres" placeholder="<%= AutoPost::DEFAULT_GENRES %>" class="nav-in ap-in" style="width:150px"></td>
                <td><input type="number" name="<%= n %>[interval_minutes]" value="<%= ap.interval_minutes %>" data-f="interval_minutes" min="<%= AutoPost::MIN_INTERVAL %>" max="<%= AutoPost::MAX_INTERVAL %>" step="1" class="nav-in ap-in" style="width:66px"></td>
                <td><input type="number" name="<%= n %>[max_seconds]" value="<%= ap.max_seconds %>" data-f="max_seconds" min="<%= AutoPost::MIN_SECONDS %>" max="<%= AutoPost::MAX_SECONDS %>" step="1" class="nav-in ap-in" style="width:66px"></td>
                <td>
                  <label class="ap-check" title="<%= t("admin.auto_post.f_remix_hint") %>"><input type="hidden" name="<%= n %>[remix]" value="0"><input type="checkbox" name="<%= n %>[remix]" value="1" data-f="remix" <%= "checked" if ap.remix? %>> <%= t("admin.auto_post.col_remix") %></label>
                  <label class="ap-check" title="<%= t("admin.auto_post.f_bgm_hint", dir: "storage/bgm/") %>"><input type="hidden" name="<%= n %>[bgm]" value="0"><input type="checkbox" name="<%= n %>[bgm]" value="1" data-f="bgm" <%= "checked" if ap.bgm? %>> <%= t("admin.auto_post.col_bgm") %></label>
                </td>
                <td>
                  <% case ap.status_kind
                     when :dead %><span class="badge badge-danger"><%= t("admin.auto_post.status_dead") %></span>
                  <% when :ok %><span class="badge badge-success">OK</span>
                  <% when :failed %><span class="badge badge-danger"><%= t("admin.auto_post.failed") %></span>
                  <% when :queued %><span class="badge badge-muted"><%= ap.last_status %></span>
                  <% else %><span class="muted">—</span><% end %>
                  <% if ap.last_status.present? && ap.status_kind != :queued %><div class="ap-sub" title="<%= ap.last_status %>"><%= ap.last_status.sub(/\A(ok|gagal|cookie mati):\s*/, "").truncate(44) %><% if ap.last_run_at %> · <%= l(ap.last_run_at, format: :short) %><% end %></div><% end %>
                </td>
                <td class="ap-actions">
                  <button type="button" class="btn btn-secondary btn-xs" data-toggle-detail="<%= ap.id %>"><%= t("admin.auto_post.detail") %></button>
                  <button type="submit" form="ap-run-<%= ap.id %>" class="btn btn-secondary btn-xs" title="<%= t("admin.auto_post.run_now") %>"><%= t("admin.auto_post.run_now_short") %></button>
                  <button type="submit" form="ap-sync-<%= ap.id %>" class="btn btn-secondary btn-xs" title="<%= t("admin.auto_post.sync_profile") %>"><%= t("admin.auto_post.sync_short") %></button>
                  <button type="submit" form="ap-del-<%= ap.id %>" class="btn btn-danger btn-xs"><%= t("common.delete", default: "Hapus") %></button>
                </td>
              </tr>
              <tr class="ap-detail" id="ap-detail-<%= ap.id %>" data-ap-detail="<%= ap.id %>" hidden>
                <td colspan="9">
                  <div class="ap-detail-grid">
                    <div class="field">
                      <div class="field-label-row"><label><%= t("admin.auto_post.f_cookie") %></label><span class="field-hint"><%= t("admin.auto_post.f_cookie_hint") %></span></div>
                      <textarea name="<%= n %>[cookie]" rows="2" placeholder="<%= AutoPost.cookie_value(ap.cookie, 'ds_user_id').present? ? "ds_user_id=#{AutoPost.cookie_value(ap.cookie, 'ds_user_id')}; sessionid=••••••" : t("admin.auto_post.cookie_ph") %>" class="ap-cookie-in"></textarea>
                      <% if ap.cookie_dead? %><p class="domain-err" style="margin-top:4px"><%= t("admin.auto_post.dead_hint", at: l(ap.auth_failed_at, format: :short)) %></p><% end %>
                      <% if ap.profile_status.present? %><p class="muted" style="font-size:.72rem;margin:4px 0 0"><%= t("admin.auto_post.profile_status") %>: <%= ap.profile_status.truncate(80) %><% if ap.profile_synced_at %> (<%= l(ap.profile_synced_at, format: :short) %>)<% end %></p><% end %>
                    </div>
                    <div class="field">
                      <div class="field-label-row"><label><%= t("admin.auto_post.f_provider") %> / <%= t("admin.auto_post.f_drama") %></label><span class="field-hint"><%= t("admin.auto_post.f_title_manual_hint") %> <span data-ap-drama-status></span></span></div>
                      <div class="ap-drama-row">
                        <select name="<%= n %>[provider_slug]" data-ap-provider class="select-sm">
                          <option value=""><%= t("admin.auto_post.choose") %></option>
                          <% @providers.each do |p| %><option value="<%= p.slug %>" <%= "selected" if ap.provider_slug == p.slug %>><%= p.name %></option><% end %>
                        </select>
                        <input type="search" class="nav-in" placeholder="<%= t("admin.auto_post.drama_search_ph") %>" data-ap-drama-q autocomplete="off">
                        <select name="<%= n %>[drama_id]" data-ap-drama data-current="<%= ap.drama_id %>" data-current-title="<%= ap.drama_title %>" class="select-sm">
                          <option value=""><%= t("admin.auto_post.choose") %></option>
                          <% if ap.drama_id.present? %><option value="<%= ap.drama_id %>" selected><%= ap.drama_title.presence || ap.drama_id %></option><% end %>
                        </select>
                        <input type="hidden" name="<%= n %>[drama_title]" value="<%= ap.drama_title %>" data-ap-drama-title>
                      </div>
                    </div>
                    <div class="field" style="grid-column:1/-1">
                      <div class="field-label-row"><label><%= t("admin.auto_post.f_fixed_text") %></label><span class="field-hint"><%= t("admin.auto_post.f_fixed_text_hint") %></span></div>
                      <textarea name="<%= n %>[fixed_text]" rows="2" class="ap-cookie-in" style="font-family:inherit;font-size:.8rem" maxlength="1000"><%= ap.fixed_text %></textarea>
                    </div>
                  </div>
                  <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-start;margin-top:6px;font-size:.76rem">
                    <% if ap.caption_template.present? %>
                      <details><summary class="muted" style="cursor:pointer"><%= t("admin.auto_post.caption_preview") %></summary>
                        <pre style="white-space:pre-wrap;font:inherit;margin:6px 0 0;max-width:720px"><%= ap.caption_template %>

<%= ap.fixed_text %>

<%= ap.caption_tags %></pre></details>
                    <% end %>
                    <% if ap.log.any? %>
                      <details><summary class="muted" style="cursor:pointer"><%= t("admin.auto_post.log_title", n: ap.log.size) %></summary>
                        <div class="table-wrap" style="margin-top:6px"><table class="table" style="font-size:.76rem">
                          <thead><tr><th><%= t("admin.auto_post.log_at") %></th><th>EP</th><th><%= t("admin.auto_post.log_result") %></th></tr></thead>
                          <tbody>
                            <% ap.log.first(30).each do |e| %>
                              <tr><td><%= (Time.iso8601(e["at"]).in_time_zone rescue nil)&.then { |t| l(t, format: :short) } %></td><td><%= e["episode"] || "—" %> <%= e["part"] %></td>
                                <td style="white-space:normal"><% if e["ok"] %><span class="badge badge-success">OK</span> <% if e["url"] %><a href="<%= e["url"] %>" target="_blank" rel="noopener"><%= e["url"] %></a><% end %><% else %><span class="badge badge-danger"><%= t("admin.auto_post.failed") %></span> <%= e["error"] %><% end %></td></tr>
                            <% end %>
                          </tbody></table></div>
                      </details>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="ap-toolbar" style="margin-top:10px">
        <span class="muted" style="font-size:.74rem"><%= t("admin.auto_post.flow_hint") %></span>
        <button type="submit" class="btn btn-sm"><%= dm_icon("check", size: 14) %> <%= t("admin.auto_post.save_all") %></button>
      </div>
    <% end %>
  </div>

  <%# Form aksi per baris (di luar form utama; tombol memakai atribut form="…") %>
  <% @auto_posts.each do |ap| %>
    <%= form_with url: run_now_admin_instance_auto_post_path(@instance, ap), method: :post, id: "ap-run-#{ap.id}", data: { turbo: false }, html: { hidden: true, onsubmit: "return confirm(#{t('admin.auto_post.run_now_confirm').to_json})" } do %><% end %>
    <%= form_with url: sync_profile_admin_instance_auto_post_path(@instance, ap), method: :post, id: "ap-sync-#{ap.id}", data: { turbo: false }, html: { hidden: true } do %><% end %>
    <%= form_with url: admin_instance_auto_post_path(@instance, ap), method: :delete, id: "ap-del-#{ap.id}", data: { turbo: false }, html: { hidden: true, onsubmit: "return confirm(#{t('admin.auto_post.delete_confirm', label: ap.label).to_json})" } do %><% end %>
  <% end %>

<script>
(function () {
  var i18n = { loading: <%= t("admin.auto_post.loading").to_json.html_safe %>, choose: <%= t("admin.auto_post.choose").to_json.html_safe %>, failed: <%= t("admin.auto_post.load_failed").to_json.html_safe %>, count: <%= t("admin.auto_post.titles_count").to_json.html_safe %> };
  var card = document.getElementById("ap-table-card"); if (!card) return;

  /* baris detail: buka/tutup; buka otomatis bila URL #ap-<id> */
  document.querySelectorAll("[data-toggle-detail]").forEach(function (b) {
    b.addEventListener("click", function () { var d = document.getElementById("ap-detail-" + b.dataset.toggleDetail); d.hidden = !d.hidden; b.classList.toggle("is-active", !d.hidden); });
  });
  var m = location.hash.match(/^#ap-(\d+)$/); if (m) { var d0 = document.getElementById("ap-detail-" + m[1]); if (d0) d0.hidden = false; }

  /* ⇩ di header: salin nilai baris pertama ke semua baris (kolom itu), lalu tinggal Simpan semua */
  document.querySelectorAll(".fill-btn").forEach(function (b) {
    b.addEventListener("click", function () {
      b.dataset.fill.split(",").forEach(function (f) {
        var all = card.querySelectorAll('[data-f="' + f + '"]'); if (all.length < 2) return;
        var src = all[0];
        all.forEach(function (el, i) { if (i === 0) return; if (el.type === "checkbox") el.checked = src.checked; else el.value = src.value; el.classList.add("is-filled"); });
      });
    });
  });

  /* dropdown judul per baris detail: muat dari provider terpilih (beranda + pencarian), hanya saat dibuka */
  document.querySelectorAll("[data-ap-detail]").forEach(function (box) {
    var prov = box.querySelector("[data-ap-provider]"), sel = box.querySelector("[data-ap-drama]"), q = box.querySelector("[data-ap-drama-q]"),
        status = box.querySelector("[data-ap-drama-status]"), titleIn = box.querySelector("[data-ap-drama-title]"), timer = null, loaded = false;
    function loadDramas() {
      var p = prov.value; if (!p) { sel.innerHTML = "<option value=''>" + i18n.choose + "</option>"; status.textContent = ""; return; }
      status.textContent = i18n.loading;
      var url = card.dataset.dramasUrl + "?provider=" + encodeURIComponent(p) + (q.value.trim() ? "&q=" + encodeURIComponent(q.value.trim()) : "");
      fetch(url, { headers: { Accept: "application/json" }, credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (j) {
        var cur = sel.dataset.current, curTitle = sel.dataset.currentTitle, found = false;
        sel.innerHTML = "<option value=''>" + i18n.choose + "</option>";
        (j.items || []).forEach(function (d) { var o = document.createElement("option"); o.value = d.id; o.textContent = d.title; if (d.id === cur) { o.selected = true; found = true; } sel.appendChild(o); });
        if (cur && !found && curTitle) { var o = document.createElement("option"); o.value = cur; o.textContent = curTitle; o.selected = true; sel.insertBefore(o, sel.children[1]); }
        status.textContent = j.error ? (i18n.failed + ": " + j.error) : i18n.count.replace("{n}", (j.items || []).length);
      }).catch(function () { status.textContent = i18n.failed; });
    }
    prov.addEventListener("change", function () { sel.dataset.current = ""; sel.dataset.currentTitle = ""; titleIn.value = ""; q.value = ""; loadDramas(); });
    q.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(loadDramas, 400); });
    sel.addEventListener("change", function () { sel.dataset.current = sel.value; titleIn.value = sel.selectedOptions[0] ? sel.selectedOptions[0].textContent : ""; sel.dataset.currentTitle = titleIn.value; });
    function lazy() { if (!loaded && prov.value) { loaded = true; loadDramas(); } }
    sel.addEventListener("focus", lazy); sel.addEventListener("mousedown", lazy); q.addEventListener("focus", lazy);
  });

  /* peringatan bila meninggalkan halaman dengan perubahan belum disimpan */
  var dirty = false, form = document.getElementById("ap-bulk");
  form.addEventListener("input", function () { dirty = true; });
  form.addEventListener("submit", function () { dirty = false; });
  window.addEventListener("beforeunload", function (e) { if (dirty) { e.preventDefault(); e.returnValue = ""; } });
})();
</script>
  <% end %>
<% end %>
