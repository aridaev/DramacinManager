<% content_for :page_actions do %>
  <%= link_to edit_admin_instance_path(@instance, anchor: "sec-members"), class: "btn btn-sm btn-secondary" do %><%= dm_icon("box", size: 16) %> <%= t("admin.members.back_to_instance") %><% end %>
<% end %>
<%= render layout: "shared/app_shell", locals: { title: t("admin.members.title", name: @instance.name), subtitle: t("admin.members.subtitle", price: @instance.adfree_price, days: @instance.adfree_days) } do %>
  <div class="stats">
    <div class="stat is-bad"><span class="stat-label"><%= t("admin.members.stat_pending") %></span><span class="stat-num"><%= @pending.size %></span></div>
    <div class="stat is-ok"><span class="stat-label"><%= t("admin.members.stat_adfree") %></span><span class="stat-num"><%= @members.count(&:adfree?) %></span></div>
    <div class="stat"><span class="stat-label"><%= t("admin.members.stat_members") %></span><span class="stat-num"><%= @members.size %></span></div>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t("admin.members.pending_title") %></h2></div>
    <% if @pending.empty? %>
      <p class="muted"><%= t("admin.members.pending_empty") %></p>
    <% else %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th><%= t("admin.members.col_user") %></th><th><%= t("admin.members.col_time") %></th><th><%= t("admin.members.col_note") %></th><th><%= t("admin.members.col_proof") %></th><th class="col-action"><%= t("admin.providers.col_action") %></th></tr></thead>
        <tbody>
          <% @pending.each do |r| %>
            <tr>
              <td><strong><%= r.member.username %></strong><br><span class="muted" style="font-size:.76rem"><%= r.amount.presence || "—" %></span></td>
              <td><%= I18n.l(r.created_at, format: :short) %></td>
              <td><%= r.note.presence || "—" %></td>
              <td><% if r.proof_url %><a href="<%= r.proof_url %>" target="_blank" rel="noopener"><img src="<%= r.proof_url %>" alt="" style="height:56px;border-radius:6px;object-fit:cover"></a><% else %>—<% end %></td>
              <td class="col-action">
                <%= form_with url: approve_admin_instance_member_path(@instance, r), method: :post, data: { turbo: false }, html: { style: "display:inline-flex;gap:6px;align-items:center" } do %>
                  <input type="number" name="days" value="<%= r.days || @instance.adfree_days %>" min="1" max="3650" style="width:72px" aria-label="<%= t("admin.members.days") %>"> <span class="muted" style="font-size:.76rem"><%= t("admin.members.days") %></span>
                  <button type="submit" class="btn btn-sm"><%= dm_icon("check", size: 14) %> <%= t("admin.members.approve") %></button>
                <% end %>
                <%= button_to t("admin.members.reject"), reject_admin_instance_member_path(@instance, r), method: :post, class: "btn btn-sm btn-danger", form: { style: "display:inline", data: { turbo: false, turbo_confirm: t("admin.members.reject_confirm") }, onsubmit: "return confirm(this.dataset.turboConfirm)" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-head"><h2><%= t("admin.members.members_title") %></h2></div>
    <% if @members.empty? %>
      <p class="muted"><%= t("admin.members.members_empty") %></p>
    <% else %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th><%= t("admin.members.col_user") %></th><th><%= t("admin.members.col_status") %></th><th><%= t("admin.members.col_until") %></th><th><%= t("admin.members.col_last_login") %></th><th class="col-action"><%= t("admin.providers.col_action") %></th></tr></thead>
        <tbody>
          <% @members.each do |m| %>
            <tr>
              <td><strong><%= m.username %></strong><br><span class="muted" style="font-size:.76rem"><%= t("admin.members.joined", time: I18n.l(m.created_at, format: :short)) %></span></td>
              <td><% if m.adfree? %><span class="badge badge-success"><%= t("admin.members.adfree") %></span><% elsif m.adfree_until %><span class="badge badge-danger"><%= t("admin.members.expired") %></span><% else %><span class="badge badge-muted"><%= t("admin.members.with_ads") %></span><% end %></td>
              <td><%= m.adfree_until ? I18n.l(m.adfree_until, format: :short) : "—" %><% if m.adfree? %> <span class="muted" style="font-size:.76rem">(<%= t("admin.members.days_left", n: m.adfree_days_left) %>)</span><% end %></td>
              <td><%= m.last_login_at ? I18n.l(m.last_login_at, format: :short) : "—" %></td>
              <td class="col-action">
                <%= form_with url: grant_admin_instance_member_path(@instance, m), method: :post, data: { turbo: false }, html: { style: "display:inline-flex;gap:6px;align-items:center" } do %>
                  <input type="number" name="days" value="<%= @instance.adfree_days %>" min="1" max="3650" style="width:72px" aria-label="<%= t("admin.members.days") %>">
                  <button type="submit" class="btn btn-sm btn-secondary"><%= t("admin.members.grant") %></button>
                <% end %>
                <% if m.adfree? %><%= button_to t("admin.members.revoke"), revoke_admin_instance_member_path(@instance, m), method: :post, class: "btn btn-sm btn-secondary", form: { style: "display:inline", data: { turbo: false } } %><% end %>
                <%= button_to t("common.delete", default: "Hapus"), admin_instance_member_path(@instance, m), method: :delete, class: "btn btn-sm btn-danger", form: { style: "display:inline", data: { turbo: false }, onsubmit: "return confirm('#{j t('admin.members.delete_confirm')}')" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    <% end %>
  </div>

  <% if @recent.any? %>
  <div class="card">
    <div class="card-head"><h2><%= t("admin.members.history_title") %></h2></div>
    <div class="table-wrap"><table class="table">
      <thead><tr><th><%= t("admin.members.col_user") %></th><th><%= t("admin.members.col_status") %></th><th><%= t("admin.members.days") %></th><th><%= t("admin.members.col_reviewed") %></th><th><%= t("admin.members.col_note") %></th></tr></thead>
      <tbody>
        <% @recent.each do |r| %>
          <tr><td><%= r.member.username %></td><td><span class="badge <%= r.approved? ? 'badge-success' : 'badge-danger' %>"><%= t("admin.members.status_#{r.status}") %></span></td><td><%= r.days || "—" %></td><td><%= r.reviewed_at ? I18n.l(r.reviewed_at, format: :short) : "—" %></td><td><%= r.note.presence || "—" %></td></tr>
        <% end %>
      </tbody>
    </table></div>
  </div>
  <% end %>
<% end %>
