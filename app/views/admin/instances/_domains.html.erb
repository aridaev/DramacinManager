<%# Kartu Domain. Dipakai di halaman edit instance; semua form diletakkan tersembunyi SETELAH kartu
    (tombol memakai atribut form="…") agar tidak bersarang di dalam form utama instance. %>
<section class="card inst-sec" id="sec-domains">
  <div class="card-head">
    <h2><%= t("admin.domains.title") %></h2>
    <span class="muted" style="font-size:.76rem"><%= t("admin.domains.hint") %></span>
  </div>

  <% unless @cf_ready %>
    <div class="flash flash-alert" style="margin-bottom:12px">
      <%= t("admin.domains.cf_not_ready") %>
      <% if admin? %> <%= link_to t("admin.site_settings.title"), edit_admin_site_settings_path %><% end %>
    </div>
  <% end %>

  <% if @domains.any? %>
    <div class="domain-list">
      <% @domains.each do |d| %>
        <div class="domain-card <%= d.status %>">
          <div class="domain-head">
            <div>
              <strong class="domain-host"><%= d.hostname %></strong>
              <span class="badge <%= d.active? ? 'badge-success' : (d.error? ? 'badge-danger' : 'badge-info') %>"><%= t("admin.domains.statuses.#{d.status}") %></span>
              <% if d.cf_status.present? %><span class="auth-pill" title="status zone Cloudflare">CF: <%= d.cf_status %></span><% end %>
            </div>
            <span class="inline-actions">
              <button type="submit" form="dom-refresh-<%= d.id %>" class="btn btn-secondary btn-xs" <%= "disabled" if d.cf_zone_id.blank? %>><%= t("admin.domains.check") %></button>
              <% if d.error? || d.cf_zone_id.blank? %>
                <button type="submit" form="dom-retry-<%= d.id %>" class="btn btn-secondary btn-xs" <%= "disabled" unless @cf_ready %>><%= t("admin.domains.retry") %></button>
              <% end %>
              <button type="submit" form="dom-delete-<%= d.id %>" class="btn btn-danger btn-xs"><%= t("common.delete") %></button>
            </span>
          </div>

          <% if d.active? %>
            <p class="domain-ok"><%= dm_icon("check", size: 14) %> <%= t("admin.domains.active_text", url: "https://#{d.hostname}") %> <%= link_to "https://#{d.hostname}", "https://#{d.hostname}", target: "_blank", rel: "noopener" %></p>
            <div class="domain-geo">
              <span class="muted"><%= t("admin.domains.geo_label") %>:</span>
              <% no_zone = d.cf_zone_id.blank? %>
              <% if d.geo_restricted? %>
                <span class="badge badge-success" title="<%= d.geo_codes.map { |c| Domain::GEO_COUNTRIES[c] || c }.join(', ') %>"><%= t("admin.domains.geo_only", country: Domain.geo_summary(d.geo_codes)) %></span>
                <button type="submit" form="dom-geo-off-<%= d.id %>" class="btn btn-secondary btn-xs"><%= t("admin.domains.geo_open") %></button>
              <% else %>
                <span class="badge badge-muted"><%= t("admin.domains.geo_all") %></span>
              <% end %>
              <button type="submit" form="dom-geo-id-<%= d.id %>" class="btn btn-secondary btn-xs" <%= "disabled" if no_zone %>><%= t("admin.domains.geo_set_id") %></button>
              <button type="submit" form="dom-geo-asia-<%= d.id %>" class="btn btn-secondary btn-xs" <%= "disabled" if no_zone %>><%= t("admin.domains.geo_set_asia") %></button>
              <details class="geo-pick">
                <summary class="btn btn-secondary btn-xs"><%= t("admin.domains.geo_pick") %></summary>
                <div class="geo-pick-box">
                  <div class="geo-pick-grid">
                    <% Domain::GEO_COUNTRIES.sort_by { |_, name| name }.each do |code, name| %>
                      <label class="geo-opt"><input type="checkbox" name="countries[]" value="<%= code %>" form="dom-geo-pick-<%= d.id %>" <%= "checked" if d.geo_codes.include?(code) %>> <%= name %> <span class="muted">(<%= code %>)</span></label>
                    <% end %>
                  </div>
                  <button type="submit" form="dom-geo-pick-<%= d.id %>" class="btn btn-sm" <%= "disabled" if no_zone %>><%= t("admin.domains.geo_apply") %></button>
                </div>
              </details>
              <span class="muted" style="font-size:.72rem;flex-basis:100%"><%= t("admin.domains.geo_hint") %></span>
            </div>
          <% elsif d.nameservers.any? %>
            <p class="muted" style="margin:6px 0"><%= t("admin.domains.ns_instruction_html", hostname: d.hostname) %></p>
            <div class="ns-list">
              <% d.nameservers.each do |ns| %>
                <div class="ns-item"><code><%= ns %></code><button type="button" class="btn btn-secondary btn-xs copy-ns" data-copy="<%= ns %>"><%= t("admin.domains.copy") %></button></div>
              <% end %>
            </div>
            <p class="muted" style="font-size:.74rem;margin:8px 0 0"><%= t("admin.domains.ns_note") %></p>
          <% end %>
          <% if d.last_error.present? %><p class="domain-err"><%= d.last_error %></p><% end %>
          <% if d.last_checked_at %><p class="muted" style="font-size:.72rem;margin:6px 0 0"><%= t("admin.domains.last_checked") %>: <%= l(d.last_checked_at, format: :short) %></p><% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="muted"><%= t("admin.domains.empty") %></p>
  <% end %>

  <div class="domain-add">
    <input type="text" name="domain[hostname]" form="dom-add-form" placeholder="contoh.com" required autocomplete="off" <%= "disabled" unless @cf_ready %>>
    <button type="submit" form="dom-add-form" class="btn btn-sm" <%= "disabled" unless @cf_ready %>><%= t("admin.domains.add") %></button>
  </div>
</section>
