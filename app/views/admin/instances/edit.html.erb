<% content_for :page_actions do %>
  <%= link_to t("common.cancel"), admin_instance_path(@instance), class: "btn btn-secondary btn-sm" %>
  <button type="submit" form="instance-form" class="btn btn-sm"><%= dm_icon("check", size: 16) %> <%= t("common.save") %></button>
<% end %>
<%= render layout: "shared/app_shell", locals: { title: t("admin.instances.edit_title", name: @instance.name), subtitle: t("admin.instances.edit_subtitle") } do %>
  <%= form_with model: [:admin, @instance], id: "instance-form", class: "inst-layout" do |f| %>
    <aside class="inst-side">
      <nav class="inst-tabs" aria-label="Bagian">
        <% { general: "grid", template: "layers", branding: "box", theme: "palette", watermark: "box", seo: "external", ai: "plug", search: "check", footer: "layers", nav: "menu" }.each_with_index do |(k, ic), i| %>
          <a href="#sec-<%= k %>" class="inst-tab <%= 'is-active' if i.zero? %>" data-sec="sec-<%= k %>"><%= dm_icon(ic, size: 16) %><span><%= t("admin.instances.sec_#{k}") %></span></a>
        <% end %>
      </nav>
      <div class="inst-meta">
        <div><span class="muted"><%= t("admin.instances.col_name") %></span><br><code><%= @instance.name %></code></div>
        <div><span class="muted"><%= t("admin.instances.col_status") %></span><br><% if admin? %><%= f.select :status, Instance.statuses.keys.map { |s| [t("admin.instances.statuses.#{s}"), s] }, {}, class: "select-sm" %><% else %><span class="badge <%= @instance.active? ? 'badge-success' : 'badge-muted' %>"><%= t("admin.instances.statuses.#{@instance.status}") %></span><% end %></div>
      </div>
    </aside>

    <div class="inst-main">
      <% if @instance.errors.any? %>
        <div class="form-errors">
          <strong><%= t("common.errors_heading") %></strong>
          <ul><% @instance.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
        </div>
      <% end %>

      <section class="card inst-sec" id="sec-general">
        <div class="card-head"><h2><%= t("admin.instances.sec_general") %></h2></div>
        <div class="form-row">
          <div class="field">
            <div class="field-label-row"><%= f.label :app_name, t("admin.instances.f_app_name") %><span class="field-hint"><%= t("admin.instances.f_app_name_hint") %></span></div>
            <%= f.text_field :app_name, placeholder: "Dracin Drama" %>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :title, t("admin.instances.col_title") %><span class="field-hint"><%= t("admin.instances.title_placeholder") %></span></div>
            <%= f.text_field :title %>
          </div>
        </div>
        <div class="field">
          <%= f.label :notes, t("admin.api_sources.f_notes") %>
          <%= f.text_area :notes, rows: 2 %>
        </div>
      </section>

      <section class="card inst-sec" id="sec-template">
        <div class="card-head"><h2><%= t("admin.instances.sec_template") %></h2><span class="muted" style="font-size:.76rem"><%= t("admin.instances.template_hint") %></span></div>
        <div class="tpl-grid">
          <% Instance::TEMPLATES.each do |key, info| %>
            <label class="tpl-card <%= 'is-selected' if @instance.template_key == key %>">
              <%= f.radio_button :template, key, checked: @instance.template_key == key %>
              <span class="tpl-thumb" style="--tpl-accent:<%= info[:accent] %>;--tpl-bg:<%= info[:bg] %>" data-tpl="<%= key %>"><span class="tpl-thumb-bar"></span><span class="tpl-thumb-hero"></span><span class="tpl-thumb-row"><i></i><i></i><i></i><i></i></span></span>
              <span class="tpl-body">
                <strong><%= info[:name] %> <code><%= key %></code> <% if info[:status] == "stable" %><span class="badge badge-success"><%= t("admin.instances.tpl_stable") %></span><% else %><span class="badge badge-info"><%= info[:status] %></span><% end %></strong>
                <span class="muted"><%= info[:description] %></span>
                <%= link_to info[:path], info[:path], target: "_blank", rel: "noopener", class: "tpl-link" %>
              </span>
            </label>
          <% end %>
        </div>
      </section>

      <section class="card inst-sec" id="sec-branding">
        <div class="card-head"><h2><%= t("admin.instances.sec_branding") %></h2></div>
        <div class="form-row">
          <div class="field">
            <div class="field-label-row"><%= f.label :icon_url, t("admin.instances.f_icon") %><span class="field-hint"><%= t("admin.instances.f_icon_hint") %></span></div>
            <div class="input-preview">
              <span class="preview-box preview-box-sm"><% if @instance.icon_url.present? %><%= image_tag @instance.icon_url, alt: "", class: "preview-icon", data: { preview: "icon" } %><% else %><img alt="" class="preview-icon" data-preview="icon" hidden><span class="preview-empty">icon</span><% end %></span>
              <%= f.url_field :icon_url, placeholder: "https://.../favicon.png", data: { preview_for: "icon" } %>
            </div>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :logo_url, t("admin.instances.f_logo") %><span class="field-hint"><%= t("admin.instances.f_logo_hint") %></span></div>
            <div class="input-preview">
              <span class="preview-box"><% if @instance.logo_url.present? %><%= image_tag @instance.logo_url, alt: "", class: "preview-logo", data: { preview: "logo" } %><% else %><img alt="" class="preview-logo" data-preview="logo" hidden><span class="preview-empty">logo</span><% end %></span>
              <%= f.url_field :logo_url, placeholder: "https://.../logo.svg", data: { preview_for: "logo" } %>
            </div>
          </div>
        </div>
      </section>

      <section class="card inst-sec" id="sec-theme">
        <div class="card-head">
          <h2><%= t("admin.instances.sec_theme") %></h2>
          <span class="muted" style="font-size:.76rem"><%= t("admin.instances.theme_hint") %></span>
        </div>

        <div class="field">
          <div class="field-label-row"><label><%= t("admin.instances.theme_presets") %></label><span class="field-hint"><%= t("admin.instances.theme_presets_hint") %></span></div>
          <div class="theme-presets">
            <% Instance::THEME_PRESETS.each do |key, p| %>
              <button type="button" class="theme-preset" data-preset="<%= p.to_json %>" title="<%= p[:name] %>">
                <span class="theme-preset-sw" style="background:<%= p[:bg_dark] %>"><i style="background:<%= p[:accent] %>"></i><i style="background:<%= p[:surface_dark] %>"></i></span>
                <span><%= p[:name] %></span>
              </button>
            <% end %>
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <div class="field-label-row"><%= f.label :theme_accent, t("admin.instances.f_accent") %><span class="field-hint"><%= t("admin.instances.f_accent_hint") %></span></div>
            <%= render "color_input", f: f, key: :theme_accent, value: @instance.theme_accent, default: Instance::THEME_DEFAULTS["theme_accent"] %>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :theme_default, t("admin.instances.f_theme_default") %><span class="field-hint"><%= t("admin.instances.f_theme_default_hint") %></span></div>
            <%= f.select :theme_default, [ [ t("admin.instances.theme_dark"), "dark" ], [ t("admin.instances.theme_light"), "light" ] ], { selected: @instance.theme_default.presence || "dark" } %>
          </div>
        </div>

        <div class="theme-cols">
          <div class="theme-col">
            <h3><%= dm_icon("moon", size: 14) %> <%= t("admin.instances.theme_dark") %></h3>
            <div class="field"><%= f.label :theme_bg_dark, t("admin.instances.f_bg") %><%= render "color_input", f: f, key: :theme_bg_dark, value: @instance.theme_bg_dark, default: Instance::THEME_DEFAULTS["theme_bg_dark"] %></div>
            <div class="field"><%= f.label :theme_surface_dark, t("admin.instances.f_surface") %><%= render "color_input", f: f, key: :theme_surface_dark, value: @instance.theme_surface_dark, default: Instance::THEME_DEFAULTS["theme_surface_dark"] %></div>
            <div class="field"><%= f.label :theme_text_dark, t("admin.instances.f_text") %><%= render "color_input", f: f, key: :theme_text_dark, value: @instance.theme_text_dark, default: Instance::THEME_DEFAULTS["theme_text_dark"] %></div>
          </div>
          <div class="theme-col">
            <h3><%= dm_icon("sun", size: 14) %> <%= t("admin.instances.theme_light") %></h3>
            <div class="field"><%= f.label :theme_bg_light, t("admin.instances.f_bg") %><%= render "color_input", f: f, key: :theme_bg_light, value: @instance.theme_bg_light, default: Instance::THEME_DEFAULTS["theme_bg_light"] %></div>
            <div class="field"><%= f.label :theme_surface_light, t("admin.instances.f_surface") %><%= render "color_input", f: f, key: :theme_surface_light, value: @instance.theme_surface_light, default: Instance::THEME_DEFAULTS["theme_surface_light"] %></div>
            <div class="field"><%= f.label :theme_text_light, t("admin.instances.f_text") %><%= render "color_input", f: f, key: :theme_text_light, value: @instance.theme_text_light, default: Instance::THEME_DEFAULTS["theme_text_light"] %></div>
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <div class="field-label-row"><%= f.label :theme_font, t("admin.instances.f_font") %><span class="field-hint"><%= t("admin.instances.f_font_hint") %></span></div>
            <%= f.select :theme_font, Instance::THEME_FONTS.map { |k, v| [ v[:name], k ] }, { selected: @instance.theme_font.presence || "default" } %>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :theme_radius, t("admin.instances.f_radius") %><span class="field-hint"><%= t("admin.instances.f_radius_hint") %></span></div>
            <%= f.select :theme_radius, [ [ t("admin.instances.radius_sharp"), "sharp" ], [ t("admin.instances.radius_normal"), "normal" ], [ t("admin.instances.radius_round"), "round" ] ], { selected: @instance.theme_radius.presence || "normal" } %>
          </div>
        </div>

        <div class="field">
          <div class="field-label-row"><label><%= t("admin.instances.theme_preview") %></label><span class="field-hint"><%= t("admin.instances.theme_preview_hint") %></span></div>
          <div class="theme-preview" id="theme-preview" data-mode="dark">
            <div class="tp-top">
              <span class="tp-brand"><i class="tp-mark"></i><b data-tp="app"><%= @instance.app_name.presence || "Dracin" %></b></span>
              <span class="tp-links"><span class="is-on">Beranda</span><span>Genre</span><span>Terbaru</span></span>
              <button type="button" class="tp-toggle" data-tp-toggle>☾ / ☀</button>
            </div>
            <div class="tp-body">
              <div class="tp-hero"><span class="tp-pill">EP 1-80</span><b>Judul Drama Pilihan</b><span class="tp-btn">▶ Tonton</span></div>
              <div class="tp-cards"><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
          </div>
        </div>
      </section>

      <section class="card inst-sec" id="sec-watermark">
        <div class="card-head"><h2><%= t("admin.instances.sec_watermark") %></h2><span class="muted" style="font-size:.76rem"><%= t("admin.instances.watermark_hint") %></span></div>
        <div class="form-row form-row-3">
          <div class="field">
            <div class="field-label-row"><%= f.label :watermark_url, t("admin.instances.f_watermark") %><span class="field-hint"><%= t("admin.instances.f_watermark_hint") %></span></div>
            <div class="input-preview">
              <span class="preview-box"><% if @instance.watermark_url.present? %><%= image_tag @instance.watermark_url, alt: "", class: "preview-logo", data: { preview: "wm" } %><% else %><img alt="" class="preview-logo" data-preview="wm" hidden><span class="preview-empty">wm</span><% end %></span>
              <%= f.url_field :watermark_url, placeholder: "https://.../watermark.png", data: { preview_for: "wm" } %>
            </div>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :watermark_position, t("admin.instances.f_wm_position") %></div>
            <%= f.select :watermark_position, Instance::WATERMARK_POSITIONS.map { |p| [ t("admin.instances.wm_pos.#{p}"), p ] }, { selected: @instance.watermark_pos } %>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :watermark_size, t("admin.instances.f_wm_size") %></div>
            <%= f.select :watermark_size, Instance::WATERMARK_SIZES.map { |z| [ t("admin.instances.wm_size.#{z}"), z ] }, { selected: @instance.watermark_size_key }, onchange: "document.getElementById('wm-demo').dataset.size=this.value" %>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <div class="field-label-row"><%= f.label :watermark_opacity, t("admin.instances.f_wm_opacity") %><span class="field-hint" id="wm-op-val"><%= @instance.watermark_alpha %>%</span></div>
            <%= f.range_field :watermark_opacity, value: @instance.watermark_alpha, min: 10, max: 100, step: 5, oninput: "document.getElementById('wm-op-val').textContent=this.value+'%';document.getElementById('wm-demo-img').style.opacity=this.value/100" %>
          </div>
          <div class="field">
            <div class="field-label-row"><label><%= t("admin.instances.theme_preview") %></label></div>
            <div class="wm-demo" data-pos="<%= @instance.watermark_pos %>" data-size="<%= @instance.watermark_size_key %>" id="wm-demo">
              <% if @instance.watermark_src.present? %><img id="wm-demo-img" src="<%= @instance.watermark_src %>" alt="" style="opacity:<%= @instance.watermark_alpha / 100.0 %>"><% else %><img id="wm-demo-img" alt="" hidden><span class="wm-demo-empty"><%= t("admin.instances.wm_none") %></span><% end %>
              <span class="wm-demo-play">▶</span>
            </div>
          </div>
        </div>
        <p class="muted" style="font-size:.76rem;margin:8px 0 0"><%= t("admin.instances.wm_download_note") %></p>
              <div class="field">
          <label class="check-row"><%= f.check_box :protect_source, { checked: @instance.protect_source? }, "1", "0" %> <%= t("admin.instances.f_protect_source") %></label>
          <span class="field-hint"><%= t("admin.instances.f_protect_source_hint") %></span>
        </div>
</section>

      <section class="card inst-sec" id="sec-seo">
        <div class="card-head"><h2><%= t("admin.instances.sec_seo") %></h2></div>
        <div class="field">
          <div class="field-label-row"><%= f.label :site_title, t("admin.instances.f_site_title") %><span class="field-hint" data-count-for="instance_site_title"><%= @instance.site_title.to_s.length %>/70</span></div>
          <%= f.text_field :site_title, maxlength: 70 %>
        </div>
        <div class="field">
          <div class="field-label-row"><%= f.label :meta_description, t("admin.instances.f_meta") %><span class="field-hint" data-count-for="instance_meta_description"><%= @instance.meta_description.to_s.length %>/160</span></div>
          <%= f.text_area :meta_description, rows: 3, maxlength: 160 %>
        </div>
        <div class="field">
          <div class="field-label-row"><%= f.label :seo_content, t("admin.instances.f_seo_content") %><span class="field-hint"><%= t("admin.instances.seo_words", count: @instance.seo_word_count) %> · <%= t("admin.instances.f_seo_content_hint") %></span></div>
          <%= f.text_area :seo_content, rows: 12, placeholder: t("admin.instances.f_seo_content_ph"), style: "font-family:ui-monospace,monospace;font-size:.8rem" %>
        </div>
        <div class="serp">
          <div class="serp-title" data-serp="title"><%= @instance.site_title.presence || @instance.app_name.presence || t("admin.instances.serp_title_placeholder") %></div>
          <div class="serp-url">dracin.aridaev.com › …</div>
          <div class="serp-desc" data-serp="desc"><%= @instance.meta_description.presence || t("admin.instances.serp_desc_placeholder") %></div>
        </div>
      </section>

      <section class="card inst-sec" id="sec-ai">
        <div class="card-head"><h2><%= t("admin.instances.sec_ai") %></h2><span class="muted" style="font-size:.76rem"><%= t("admin.instances.ai_hint") %></span></div>
        <% tp_ready = Setting.tokenplus_api_key.present? %>
        <% unless tp_ready %><p class="form-errors" style="margin-bottom:12px"><%= t("admin.instances.ai_not_configured") %> <% if admin? %><%= link_to t("admin.instances.ai_setup_link"), edit_admin_site_settings_path(anchor: "tokenplus") %><% end %></p><% end %>
        <div class="field">
          <div class="field-label-row"><%= f.label :seo_keywords, t("admin.instances.f_seo_keywords") %><span class="field-hint"><%= t("admin.instances.f_seo_keywords_hint") %></span></div>
          <%= f.text_area :seo_keywords, rows: 2, placeholder: t("admin.instances.f_seo_keywords_ph") %>
          <span class="field-hint"><%= t("admin.instances.kw_auto_hint") %></span>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
          <button type="submit" class="btn btn-sm" formaction="<%= generate_seo_admin_instance_path(@instance) %>" formmethod="post" data-turbo="false" <%= "disabled" unless tp_ready %> onclick="return confirm(this.dataset.confirm)" data-confirm="<%= t('admin.instances.ai_generate_confirm') %>"><%= dm_icon("plug", size: 16) %> <%= t("admin.instances.ai_generate") %></button>
          <% if tp_ready %><span class="muted" style="font-size:.78rem"><%= Setting.tokenplus_model %></span><% end %>
          <% if @instance.seo_generated_at.present? %><span class="muted" style="font-size:.78rem"><%= t("admin.instances.ai_last", time: (I18n.l(Time.zone.parse(@instance.seo_generated_at), format: :short) rescue @instance.seo_generated_at)) %></span><% end %>
        </div>
      </section>

      <section class="card inst-sec" id="sec-search">
        <div class="card-head"><h2><%= t("admin.instances.sec_search") %></h2><span class="muted" style="font-size:.76rem"><%= t("admin.instances.search_hint") %></span></div>
        <% host = @instance.primary_host %>
        <% unless host %><p class="form-errors" style="margin-bottom:12px"><%= t("admin.instances.indexnow_need_domain") %></p><% end %>
        <div class="field">
          <div class="field-label-row"><%= f.label :gsc_verification, t("admin.instances.f_gsc") %><span class="field-hint"><%= t("admin.instances.f_gsc_hint") %></span></div>
          <%= f.text_field :gsc_verification, autocomplete: "off", placeholder: '<meta name="google-site-verification" content="…">' %>
        </div>
        <div class="field">
          <div class="field-label-row"><%= f.label :bing_verification, t("admin.instances.f_bing") %></div>
          <%= f.text_field :bing_verification, autocomplete: "off" %>
        </div>
        <div class="field">
          <div class="field-label-row"><label><%= t("admin.instances.seo_urls") %></label><span class="field-hint"><%= t("admin.instances.seo_urls_hint") %></span></div>
          <% base = host ? "https://#{host}" : @instance.public_url.sub(/\?.*/, "") %>
          <div class="muted" style="font-size:.8rem;line-height:1.8">
            <code><%= base %>/sitemap.xml</code><br><code><%= base %>/robots.txt</code><br>
            <%= t("admin.instances.indexnow_key") %>: <code><%= @instance.indexnow_key %></code> · <%= t("admin.instances.indexnow_key_url") %>: <code><%= base %>/<%= @instance.indexnow_key %>.txt</code>
          </div>
        </div>
        <div class="field">
          <label class="check-row"><%= f.check_box :indexnow_auto, { checked: @instance.indexnow_auto? }, "1", "0" %> <%= t("admin.instances.f_indexnow_auto") %></label>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
          <button type="submit" class="btn btn-sm btn-secondary" formaction="<%= submit_indexnow_admin_instance_path(@instance) %>" formmethod="post" data-turbo="false" <%= "disabled" unless host %>><%= dm_icon("check", size: 16) %> <%= t("admin.instances.indexnow_submit") %></button>
          <% if @instance.indexnow_last.present? %><span class="muted" style="font-size:.78rem"><%= t("admin.instances.indexnow_last", status: @instance.indexnow_last) %></span><% end %>
        </div>
      </section>

      <section class="card inst-sec" id="sec-footer">
        <div class="card-head">
          <h2><%= t("admin.instances.sec_footer") %></h2>
          <span class="muted" style="font-size:.76rem"><%= t("admin.instances.footer_hint") %></span>
        </div>
        <div class="form-row">
          <div class="field">
            <div class="field-label-row"><%= f.label :footer_text, t("admin.instances.f_footer_text") %><span class="field-hint"><%= t("admin.instances.f_footer_text_hint") %></span></div>
            <%= f.text_field :footer_text, placeholder: t("template.v1.footer.tagline") %>
          </div>
          <div class="field">
            <div class="field-label-row"><%= f.label :copyright, t("admin.instances.f_copyright") %><span class="field-hint"><%= t("admin.instances.f_copyright_hint") %></span></div>
            <%= f.text_field :copyright, placeholder: "© #{Date.current.year} Nama Situs. Hak cipta dilindungi." %>
          </div>
        </div>
        <div class="field">
          <div class="field-label-row"><%= f.label :footer_about, t("admin.instances.f_footer_about") %><span class="field-hint"><%= t("admin.instances.f_footer_about_hint") %></span></div>
          <%= f.text_area :footer_about, rows: 3, placeholder: t("admin.instances.f_footer_about_ph") %>
        </div>

        <div class="field">
          <div class="field-label-row">
            <label><%= t("admin.instances.f_footer_links") %></label>
            <button type="button" class="btn btn-secondary btn-xs" id="fl-add"><%= dm_icon("plus", size: 14) %> <%= t("admin.instances.fl_add") %></button>
          </div>
          <p class="muted" style="margin:0 0 8px;font-size:.76rem"><%= t("admin.instances.fl_hint") %></p>
          <div class="nav-builder" id="fl-builder">
            <input type="hidden" name="instance[footer_links][z][label]" value="">
            <% @instance.footer_link_items.each_with_index do |it, i| %>
              <div class="nav-row" data-fl>
                <span class="drag" title="drag">☰</span>
                <input type="text" name="instance[footer_links][<%= i %>][label]" value="<%= it["label"] %>" placeholder="<%= t("admin.instances.nav_label") %>" class="nav-in">
                <input type="text" name="instance[footer_links][<%= i %>][url]" value="<%= it["url"] %>" placeholder="/path atau https://…" class="nav-in nav-url" list="tv1-pages">
                <label class="nav-on nav-nt" title="<%= t("admin.instances.nav_new_tab") %>">↗<input type="checkbox" name="instance[footer_links][<%= i %>][new_tab]" value="1" <%= "checked" if it["new_tab"] %>></label>
                <button type="button" class="btn btn-danger btn-xs fl-del" title="<%= t("common.delete") %>">✕</button>
              </div>
            <% end %>
          </div>
          <template id="fl-tpl">
            <div class="nav-row" data-fl>
              <span class="drag">☰</span>
              <input type="text" name="instance[footer_links][__i__][label]" placeholder="<%= t("admin.instances.nav_label") %>" class="nav-in">
              <input type="text" name="instance[footer_links][__i__][url]" placeholder="/path atau https://…" class="nav-in nav-url" list="tv1-pages">
              <label class="nav-on nav-nt" title="<%= t("admin.instances.nav_new_tab") %>">↗<input type="checkbox" name="instance[footer_links][__i__][new_tab]" value="1"></label>
              <button type="button" class="btn btn-danger btn-xs fl-del">✕</button>
            </div>
          </template>
