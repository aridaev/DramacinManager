            <span class="muted"><%= t("admin.instances.quick_add") %>:</span>
            <% [ [ "Tentang", "/about" ], [ "Kebijakan Privasi", "/privacy" ], [ "DMCA", "/dmca" ], [ "Kontak", "/contact" ], [ "Semua genre", "/genre" ], [ "Terbaru", "/latest" ] ].each do |l, u| %>
              <button type="button" class="chip chip-btn" data-fl-quick data-label="<%= l %>" data-url="<%= u %>">+ <%= l %></button>
            <% end %>
          </div>
        </div>

        <div class="field">
          <div class="field-label-row"><label><%= t("admin.instances.f_social") %></label><span class="field-hint"><%= t("admin.instances.f_social_hint") %></span></div>
          <div class="social-grid">
            <% Instance::SOCIALS.each do |key, s| %>
              <label class="social-field"><span class="social-dot" style="background:<%= s[:color] %>"></span><span class="social-name"><%= s[:name] %></span><%= f.url_field "social_#{key}", placeholder: s[:placeholder], value: @instance.public_send("social_#{key}") %></label>
            <% end %>
          </div>
        </div>

        <div class="form-row">
          <div class="field"><label class="check-row"><%= f.check_box :footer_show_providers, { checked: @instance.footer_show_providers? }, "1", "0" %> <%= t("admin.instances.f_show_providers") %></label></div>
          <div class="field"><label class="check-row"><%= f.check_box :footer_show_powered, { checked: @instance.footer_show_powered? }, "1", "0" %> <%= t("admin.instances.f_show_powered") %></label></div>
        </div>
      </section>

      <section class="card inst-sec" id="sec-nav">
        <div class="card-head">
          <h2><%= t("admin.instances.sec_nav") %></h2>
          <span class="inline-actions">
            <button type="button" class="btn btn-secondary btn-xs" id="nav-reset" title="<%= t("admin.instances.nav_reset_hint") %>"><%= t("admin.instances.nav_reset") %></button>
            <button type="button" class="btn btn-secondary btn-xs" id="nav-add"><%= dm_icon("plus", size: 14) %> <%= t("admin.instances.nav_add") %></button>
          </span>
        </div>
        <p class="muted"><%= t("admin.instances.nav_hint") %></p>

        <datalist id="tv1-pages">
          <% Instance::PAGES.each do |u, l| %><option value="<%= u %>"><%= l %></option><% end %>
        </datalist>

        <div class="quick-add">
          <span class="muted"><%= t("admin.instances.quick_add") %>:</span>
          <% Instance::PAGES.each do |u, l| %>
            <button type="button" class="chip chip-btn" data-nav-quick data-label="<%= l %>" data-url="<%= u %>">+ <%= l %></button>
          <% end %>
          <button type="button" class="chip chip-btn" data-nav-genres><%= t("admin.instances.nav_genre_dropdown") %></button>
        </div>

        <div class="nav-builder" id="nav-builder">
          <% @instance.nav_items.each_with_index do |it, i| %>
            <div class="nav-item" data-item>
              <div class="nav-row">
                <span class="drag" title="drag">☰</span>
                <input type="text" name="instance[nav_items][<%= i %>][label]" value="<%= it["label"] %>" placeholder="<%= t("admin.instances.nav_label") %>" class="nav-in">
                <input type="text" name="instance[nav_items][<%= i %>][url]" value="<%= it["url"] %>" placeholder="/path" class="nav-in nav-url" list="tv1-pages">
                <label class="nav-on nav-nt" title="<%= t("admin.instances.nav_new_tab") %>">↗<input type="checkbox" name="instance[nav_items][<%= i %>][new_tab]" value="1" <%= "checked" if it["new_tab"] %>></label>
                <label class="nav-on" title="<%= t("common.enabled") %>"><input type="hidden" name="instance[nav_items][<%= i %>][enabled]" value="0"><input type="checkbox" name="instance[nav_items][<%= i %>][enabled]" value="1" <%= "checked" if it["enabled"] != false %>></label>
                <button type="button" class="btn btn-secondary btn-xs nav-sub-add" title="<%= t("admin.instances.nav_sub_add") %>">+ <%= t("admin.instances.nav_sub") %></button>
                <button type="button" class="btn btn-danger btn-xs nav-del" title="<%= t("common.delete") %>">✕</button>
              </div>
              <div class="nav-children">
                <% Array(it["children"]).each_with_index do |ch, j| %>
                  <div class="nav-row nav-child" data-child>
                    <span class="drag">└</span>
                    <input type="text" name="instance[nav_items][<%= i %>][children][<%= j %>][label]" value="<%= ch["label"] %>" placeholder="<%= t("admin.instances.nav_label") %>" class="nav-in">
                    <input type="text" name="instance[nav_items][<%= i %>][children][<%= j %>][url]" value="<%= ch["url"] %>" placeholder="/path" class="nav-in nav-url" list="tv1-pages">
                    <label class="nav-on nav-nt" title="<%= t("admin.instances.nav_new_tab") %>">↗<input type="checkbox" name="instance[nav_items][<%= i %>][children][<%= j %>][new_tab]" value="1" <%= "checked" if ch["new_tab"] %>></label>
                    <label class="nav-on"><input type="hidden" name="instance[nav_items][<%= i %>][children][<%= j %>][enabled]" value="0"><input type="checkbox" name="instance[nav_items][<%= i %>][children][<%= j %>][enabled]" value="1" <%= "checked" if ch["enabled"] != false %>></label>
                    <span class="nav-spacer"></span>
                    <button type="button" class="btn btn-danger btn-xs nav-del">✕</button>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <template id="nav-item-tpl">
          <div class="nav-item" data-item>
            <div class="nav-row">
              <span class="drag">☰</span>
              <input type="text" name="instance[nav_items][__i__][label]" placeholder="<%= t("admin.instances.nav_label") %>" class="nav-in">
              <input type="text" name="instance[nav_items][__i__][url]" placeholder="/path" class="nav-in nav-url" list="tv1-pages">
              <label class="nav-on nav-nt" title="<%= t("admin.instances.nav_new_tab") %>">↗<input type="checkbox" name="instance[nav_items][__i__][new_tab]" value="1"></label>
              <label class="nav-on"><input type="hidden" name="instance[nav_items][__i__][enabled]" value="0"><input type="checkbox" name="instance[nav_items][__i__][enabled]" value="1" checked></label>
              <button type="button" class="btn btn-secondary btn-xs nav-sub-add">+ <%= t("admin.instances.nav_sub") %></button>
              <button type="button" class="btn btn-danger btn-xs nav-del">✕</button>
            </div>
            <div class="nav-children"></div>
          </div>
        </template>
        <template id="nav-child-tpl">
          <div class="nav-row nav-child" data-child>
            <span class="drag">└</span>
            <input type="text" name="instance[nav_items][__i__][children][__j__][label]" placeholder="<%= t("admin.instances.nav_label") %>" class="nav-in">
            <input type="text" name="instance[nav_items][__i__][children][__j__][url]" placeholder="/path" class="nav-in nav-url" list="tv1-pages">
            <label class="nav-on nav-nt" title="<%= t("admin.instances.nav_new_tab") %>">↗<input type="checkbox" name="instance[nav_items][__i__][children][__j__][new_tab]" value="1"></label>
            <label class="nav-on"><input type="hidden" name="instance[nav_items][__i__][children][__j__][enabled]" value="0"><input type="checkbox" name="instance[nav_items][__i__][children][__j__][enabled]" value="1" checked></label>
            <span class="nav-spacer"></span>
            <button type="button" class="btn btn-danger btn-xs nav-del">✕</button>
          </div>
        </template>

        <div class="nav-live">
          <span class="muted"><%= t("admin.instances.nav_preview") %>:</span>
          <nav class="nav-preview" id="nav-live"></nav>
        </div>
        <p class="muted" style="font-size:.74rem;margin:8px 0 0"><%= t("admin.instances.nav_legend") %></p>
      </section>

      <div class="actions actions-row inst-actions">
        <%= f.submit t("common.save"), class: "btn" %>
        <%= link_to t("common.cancel"), admin_instance_path(@instance), class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>

<script>
(function () {
  var sec = document.getElementById("sec-theme"); if (!sec) return;
  var prev = document.getElementById("theme-preview");
  var fld = function (k) { return sec.querySelector('[data-theme-key="' + k + '"]'); };
  var val = function (k) { var el = fld(k); return (el && el.value.trim()) || (el && el.placeholder) || "#000000"; };
  function shade(h, a) { var c = h.replace("#", "").match(/../g).map(function (x) { return parseInt(x, 16); }); var t = a > 0 ? 255 : 0; a = Math.abs(a); return "#" + c.map(function (v) { return ("0" + Math.round(v + (t - v) * a).toString(16)).slice(-2); }).join(""); }
  function render() {
    var mode = prev.dataset.mode, dark = mode === "dark", d = dark ? 1 : -1;
    var bg = val("theme_bg_" + mode), sf = val("theme_surface_" + mode), tx = val("theme_text_" + mode), ac = val("theme_accent");
    var font = sec.querySelector('[name="instance[theme_font]"]'), radius = sec.querySelector('[name="instance[theme_radius]"]');
    var stacks = { "default": "'Plus Jakarta Sans', Inter, system-ui, sans-serif", inter: "Inter, system-ui, sans-serif", poppins: "Poppins, system-ui, sans-serif", nunito: "Nunito, system-ui, sans-serif", system: "system-ui, sans-serif", serif: "Georgia, serif" };
    var radii = { sharp: "4px", normal: "10px", round: "16px" };
    prev.style.cssText = "--bg:" + bg + ";--sf:" + sf + ";--sf2:" + shade(sf, 0.08 * d) + ";--tx:" + tx + ";--ac:" + ac + ";--line:" + shade(sf, 0.16 * d) + ";--r:" + radii[radius.value] + ";font-family:" + stacks[font.value];
    prev.querySelector("[data-tp=app]").textContent = (document.querySelector('[name="instance[app_name]"]') || {}).value || "Dracin";
  }
  sec.querySelectorAll("[data-color-input]").forEach(function (box) {
    var pick = box.querySelector("[data-color-pick]"), hex = box.querySelector("[data-color-hex]"), reset = box.querySelector("[data-color-reset]");
    pick.addEventListener("input", function () { hex.value = pick.value; render(); });
    hex.addEventListener("input", function () { if (/^#[0-9a-f]{6}$/i.test(hex.value)) pick.value = hex.value; render(); });
    reset.addEventListener("click", function () { hex.value = ""; pick.value = hex.placeholder; render(); });
  });
  sec.querySelectorAll("select").forEach(function (s) { s.addEventListener("change", render); });
  sec.querySelectorAll(".theme-preset").forEach(function (b) {
    b.addEventListener("click", function () {
      var p = JSON.parse(b.dataset.preset);
      [["accent", "theme_accent"], ["bg_dark", "theme_bg_dark"], ["surface_dark", "theme_surface_dark"], ["text_dark", "theme_text_dark"], ["bg_light", "theme_bg_light"], ["surface_light", "theme_surface_light"], ["text_light", "theme_text_light"]].forEach(function (m) {
        var el = fld(m[1]); el.value = p[m[0]]; el.closest("[data-color-input]").querySelector("[data-color-pick]").value = p[m[0]];
      });
      sec.querySelectorAll(".theme-preset").forEach(function (x) { x.classList.toggle("is-active", x === b); });
      render();
    });
  });
  prev.querySelector("[data-tp-toggle]").addEventListener("click", function () { prev.dataset.mode = prev.dataset.mode === "dark" ? "light" : "dark"; render(); });
  var def = sec.querySelector('[name="instance[theme_default]"]'); prev.dataset.mode = def.value || "dark";
  def.addEventListener("change", function () { prev.dataset.mode = def.value; render(); });
  render();
})();
</script>

  <script>
    (function () {
      var pos = document.querySelector('[name="instance[watermark_position]"]'), demo = document.getElementById("wm-demo");
      if (pos && demo) pos.addEventListener("change", function () { demo.dataset.pos = pos.value; });
      var wmUrl = document.querySelector('[name="instance[watermark_url]"]'), wmImg = document.getElementById("wm-demo-img");
      if (wmUrl && wmImg) wmUrl.addEventListener("input", function () { if (wmUrl.value) { wmImg.src = wmUrl.value; wmImg.hidden = false; var e = demo.querySelector(".wm-demo-empty"); if (e) e.hidden = true; } });
    })();
  </script>
  <script>
    (function () {
      /* Navbar: quick-add, dropdown genre, reset; Footer links builder */
      var root = document.getElementById("nav-builder"), itemTpl = document.getElementById("nav-item-tpl"), childTpl = document.getElementById("nav-child-tpl");
      function addNav(label, url, children) {
        root.insertAdjacentHTML("beforeend", itemTpl.innerHTML.replace(/__i__/g, root.children.length));
        var item = root.lastElementChild; item.querySelector(".nav-in").value = label; item.querySelector(".nav-url").value = url;
        (children || []).forEach(function (c) {
          var box = item.querySelector(".nav-children");
          box.insertAdjacentHTML("beforeend", childTpl.innerHTML.replace(/__i__/g, 0).replace(/__j__/g, box.children.length));
          box.lastElementChild.querySelector(".nav-in").value = c[0]; box.lastElementChild.querySelector(".nav-url").value = c[1];
        });
        root.dispatchEvent(new Event("input", { bubbles: true })); root.dispatchEvent(new Event("nav:renumber"));
      }
      document.querySelectorAll("[data-nav-quick]").forEach(function (b) { b.addEventListener("click", function () { addNav(b.dataset.label, b.dataset.url); }); });
      var genresBtn = document.querySelector("[data-nav-genres]");
      if (genresBtn) genresBtn.addEventListener("click", function () { addNav("Genre", "/genre", <%= ::Template::V1::BaseController::GENRES.map { |g| [ t("template.v1.genres.#{g}", default: g.titleize), "/genre/#{g}" ] }.to_json.html_safe %>); });
      document.getElementById("nav-reset").addEventListener("click", function () {
        if (!confirm(<%= t("admin.instances.nav_reset_confirm").to_json %>)) return;
        root.innerHTML = ""; <%= Instance::DEFAULT_NAV.map { |n| [ n["label"], n["url"] ] }.to_json.html_safe %>.forEach(function (n) { addNav(n[0], n[1]); });
      });

      var fl = document.getElementById("fl-builder"), flTpl = document.getElementById("fl-tpl");
      function flRenumber() { fl.querySelectorAll("[data-fl]").forEach(function (row, i) { row.querySelectorAll("input").forEach(function (inp) { inp.name = inp.name.replace(/\[footer_links\]\[[^\]]*\]/, "[footer_links][" + i + "]"); }); }); }
      function flAdd(label, url) {
        fl.insertAdjacentHTML("beforeend", flTpl.innerHTML.replace(/__i__/g, fl.querySelectorAll("[data-fl]").length));
        var row = fl.lastElementChild; if (label) { row.querySelector(".nav-in").value = label; row.querySelector(".nav-url").value = url; } else row.querySelector(".nav-in").focus();
        flRenumber();
      }
      document.getElementById("fl-add").addEventListener("click", function () { flAdd(); });
      document.querySelectorAll("[data-fl-quick]").forEach(function (b) { b.addEventListener("click", function () { flAdd(b.dataset.label, b.dataset.url); }); });
      fl.addEventListener("click", function (e) { var b = e.target.closest(".fl-del"); if (b) { b.closest("[data-fl]").remove(); flRenumber(); } });
      var dragging = null;
      fl.addEventListener("mousedown", function (e) { var h = e.target.closest(".drag"); if (h) h.closest("[data-fl]").draggable = true; });
      fl.addEventListener("dragstart", function (e) { dragging = e.target.closest("[data-fl]"); });
      fl.addEventListener("dragend", function () { if (dragging) dragging.draggable = false; dragging = null; flRenumber(); });
      fl.addEventListener("dragover", function (e) { if (!dragging) return; e.preventDefault(); var over = e.target.closest("[data-fl]"); if (!over || over === dragging) return; var r = over.getBoundingClientRect(); fl.insertBefore(dragging, (e.clientY - r.top) > r.height / 2 ? over.nextSibling : over); });
    })();
  </script>
  <script>
    (function () {
      /* tab bagian: scroll + highlight */
      var tabs = document.querySelectorAll(".inst-tab"), secs = document.querySelectorAll(".inst-sec");
      tabs.forEach(function (t) { t.addEventListener("click", function (e) { e.preventDefault(); document.getElementById(t.dataset.sec).scrollIntoView({ behavior: "smooth", block: "start" }); }); });
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (en) { if (en.isIntersecting) tabs.forEach(function (t) { t.classList.toggle("is-active", t.dataset.sec === en.target.id); }); });
        }, { rootMargin: "-30% 0px -60% 0px" });
        secs.forEach(function (s) { io.observe(s); });
      }
      /* preview gambar & hitung karakter & SERP */
      document.querySelectorAll("[data-preview-for]").forEach(function (inp) {
        var img = document.querySelector('[data-preview="' + inp.dataset.previewFor + '"]');
        var empty = img && img.parentElement.querySelector(".preview-empty");
        inp.addEventListener("input", function () { if (!img) return; img.src = inp.value; img.hidden = !inp.value; if (empty) empty.hidden = !!inp.value; });
      });
      document.querySelectorAll("[data-count-for]").forEach(function (c) {
        var el = document.getElementById(c.dataset.countFor), max = el.maxLength;
        el.addEventListener("input", function () { c.textContent = el.value.length + "/" + max; });
      });
      var st = document.getElementById("instance_site_title"), md = document.getElementById("instance_meta_description"), an = document.getElementById("instance_app_name");
      function serp() {
        document.querySelector('[data-serp="title"]').textContent = st.value || an.value || st.placeholder || "—";
        document.querySelector('[data-serp="desc"]').textContent = md.value || "—";
      }
      [st, md, an].forEach(function (el) { el.addEventListener("input", serp); });

      /* navbar builder */
      var root = document.getElementById("nav-builder"), itemTpl = document.getElementById("nav-item-tpl"), childTpl = document.getElementById("nav-child-tpl"), live = document.getElementById("nav-live");
      function renumber() {
        root.querySelectorAll("[data-item]").forEach(function (item, i) {
          item.querySelectorAll(":scope > .nav-row input").forEach(function (inp) { inp.name = inp.name.replace(/\[nav_items\]\[[^\]]*\]/, "[nav_items][" + i + "]"); });
          item.querySelectorAll("[data-child]").forEach(function (ch, j) {
            ch.querySelectorAll("input").forEach(function (inp) { inp.name = inp.name.replace(/\[nav_items\]\[[^\]]*\]\[children\]\[[^\]]*\]/, "[nav_items][" + i + "][children][" + j + "]"); });
          });
        });
        preview();
      }
      function preview() {
        live.innerHTML = "";
        root.querySelectorAll("[data-item]").forEach(function (item) {
          var l = item.querySelector(":scope > .nav-row .nav-in").value.trim(); if (!l) return;
          var on = item.querySelector(":scope > .nav-row input[type=checkbox]").checked;
          var kids = Array.prototype.filter.call(item.querySelectorAll("[data-child]"), function (c) { return c.querySelector(".nav-in").value.trim(); });
          var chip = document.createElement("span"); chip.className = "chip" + (on ? "" : " is-off"); chip.textContent = l + (kids.length ? " ▾" : "");
          if (kids.length) chip.title = kids.map(function (c) { return c.querySelector(".nav-in").value.trim(); }).join(", ");
          live.appendChild(chip);
        });
      }
      document.getElementById("nav-add").addEventListener("click", function () {
        root.insertAdjacentHTML("beforeend", itemTpl.innerHTML.replace(/__i__/g, root.children.length)); renumber();
        root.lastElementChild.querySelector(".nav-in").focus();
      });
      root.addEventListener("click", function (e) {
        var b = e.target.closest("button"); if (!b) return;
        if (b.classList.contains("nav-del")) { (b.closest("[data-child]") || b.closest("[data-item]")).remove(); renumber(); }
        if (b.classList.contains("nav-sub-add")) {
          var item = b.closest("[data-item]"), box = item.querySelector(".nav-children");
          box.insertAdjacentHTML("beforeend", childTpl.innerHTML.replace(/__i__/g, 0).replace(/__j__/g, box.children.length)); renumber();
          box.lastElementChild.querySelector(".nav-in").focus();
        }
      });
      root.addEventListener("input", preview); root.addEventListener("change", preview); root.addEventListener("nav:renumber", renumber);
      /* drag & drop: item di level yang sama */
      var dragging = null;
      root.addEventListener("mousedown", function (e) { var h = e.target.closest(".drag"); if (h) (h.closest("[data-child]") || h.closest("[data-item]")).draggable = true; });
      root.addEventListener("dragstart", function (e) { dragging = e.target.closest("[data-child]") || e.target.closest("[data-item]"); e.dataTransfer.effectAllowed = "move"; });
      root.addEventListener("dragend", function () { if (dragging) dragging.draggable = false; dragging = null; renumber(); });
      root.addEventListener("dragover", function (e) {
        if (!dragging) return; e.preventDefault();
        var sel = dragging.hasAttribute("data-child") ? "[data-child]" : "[data-item]";
        var over = e.target.closest(sel); if (!over || over === dragging || over.parentElement !== dragging.parentElement) return;
        var r = over.getBoundingClientRect(); over.parentElement.insertBefore(dragging, (e.clientY - r.top) > r.height / 2 ? over.nextSibling : over);
      });
      renumber();
    })();
  </script>
<% end %>
