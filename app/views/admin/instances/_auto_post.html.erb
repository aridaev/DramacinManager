<%# Ringkasan Auto Posting (Instagram) di halaman edit instance; pengelolaan per akun ada di halaman tersendiri
    (admin/auto_posts#index). Dirender di luar <form> utama lalu dipindah ke bawah "Member" oleh JS. %>
<% aps = @instance.auto_posts.where(platform: "instagram").order(:id).to_a %>
<section class="card inst-sec" id="sec-autopost">
  <div class="card-head">
    <h2><%= t("admin.auto_post.title") %></h2>
    <span class="muted" style="font-size:.76rem"><%= t("admin.auto_post.hint") %></span>
  </div>
  <% if aps.any? %>
    <div class="table-wrap" style="margin-bottom:12px"><table class="table" style="font-size:.8rem">
      <thead><tr><th><%= t("admin.auto_post.f_label") %></th><th><%= t("admin.auto_post.f_drama") %></th><th><%= t("admin.auto_post.f_interval") %></th><th><%= t("admin.auto_post.last_status") %></th></tr></thead>
      <tbody>
        <% aps.each do |ap| %>
          <tr>
            <td><%= ap.label %> <% if ap.enabled? %><span class="badge badge-success"><%= t("admin.auto_post.on") %></span><% else %><span class="badge badge-muted"><%= t("admin.auto_post.off") %></span><% end %></td>
            <td><%= ap.drama_title.presence || "—" %></td>
            <td><%= ap.interval_minutes %> <%= t("admin.auto_post.minutes") %> · ≤<%= ap.max_seconds %>s</td>
            <td class="<%= ap.last_status.to_s.start_with?("ok") ? "domain-ok" : (ap.last_status.to_s.start_with?("gagal") ? "domain-err" : "muted") %>"><%= ap.last_status.to_s.truncate(70).presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  <% end %>
  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <%= link_to admin_instance_auto_posts_path(@instance), class: "btn btn-sm btn-secondary" do %><%= dm_icon("clock", size: 14) %> <%= t("admin.auto_post.manage") %><% end %>
    <span class="muted" style="font-size:.74rem"><%= t("admin.auto_post.accounts_count", n: aps.size, on: aps.count(&:enabled?)) %></span>
  </div>
</section>
