<%# Form tersembunyi untuk kartu Auto Posting (field-nya memakai atribut form="ap-form-instagram"). %>
<%= form_with url: admin_instance_auto_post_path(@instance, "instagram"), method: :patch, id: "ap-form-instagram", data: { turbo: false }, html: { hidden: true } do %><% end %>
<script>
(function () {
  var box = document.querySelector('[data-ap="instagram"]'); if (!box) return;
  var list = box.querySelector("[data-ap-cookies]"), tpl = box.querySelector("[data-ap-cookie-tpl]");
  function renumber() { list.querySelectorAll("[data-ap-cookie]").forEach(function (row, i) { row.querySelectorAll("input,textarea").forEach(function (el) { el.name = el.name.replace(/\[cookies\]\[[^\]]*\]/, "[cookies][" + i + "]"); }); }); }
  function addRow(label, cookie) {
    var node = tpl.content.firstElementChild.cloneNode(true);
    if (label) node.querySelector("input").value = label;
    if (cookie) node.querySelector("textarea").value = cookie;
    list.appendChild(node); renumber(); return node;
  }
  box.querySelector("[data-ap-cookie-add]").addEventListener("click", function () { addRow().querySelector("textarea").focus(); });
  list.addEventListener("click", function (e) { var b = e.target.closest(".ap-cookie-del"); if (b) { b.closest("[data-ap-cookie]").remove(); renumber(); } });
  // Tempel banyak cookie sekaligus: dipisah baris kosong / baris "---"; tiap blok = satu akun.
  box.querySelector("[data-ap-cookie-paste]").addEventListener("click", function () {
    var raw = window.prompt(<%= t("admin.auto_post.paste_prompt").to_json.html_safe %>); if (!raw) return;
    var blocks = raw.trim().startsWith("[") ? [raw.trim()] : raw.split(/\n\s*(?:---+\s*)?\n|\n---+\n/).map(function (s) { return s.trim(); }).filter(Boolean);
    blocks.forEach(function (b) { addRow("", b); });
  });
  // Tempel langsung ke textarea kosong terakhir: bila isinya multi-akun, pecah jadi beberapa baris.
  list.addEventListener("paste", function (e) {
    var ta = e.target.closest("textarea"); if (!ta || ta.value) return;
    var txt = (e.clipboardData || window.clipboardData).getData("text"); if (!txt || txt.trim().startsWith("[")) return;
    var blocks = txt.split(/\n\s*\n|\n---+\n/).map(function (s) { return s.trim(); }).filter(Boolean);
    if (blocks.length < 2) return;
    e.preventDefault(); ta.value = blocks[0]; blocks.slice(1).forEach(function (b) { addRow("", b); });
  });

  /* dropdown judul: muat dari provider terpilih (beranda + pencarian) */
  var prov = box.querySelector("[data-ap-provider]"), sel = box.querySelector("[data-ap-drama]"), q = box.querySelector("[data-ap-drama-q]"),
      status = box.querySelector("[data-ap-drama-status]"), titleIn = box.querySelector("[data-ap-drama-title]"), timer = null;
  var i18n = { loading: <%= t("admin.auto_post.loading").to_json.html_safe %>, choose: <%= t("admin.auto_post.choose").to_json.html_safe %>, failed: <%= t("admin.auto_post.load_failed").to_json.html_safe %>, count: <%= t("admin.auto_post.titles_count").to_json.html_safe %> };
  function loadDramas() {
    var p = prov.value; if (!p) { sel.innerHTML = "<option value=''>" + i18n.choose + "</option>"; status.textContent = ""; return; }
    status.textContent = i18n.loading;
    var url = box.dataset.dramasUrl + "?provider=" + encodeURIComponent(p) + (q.value.trim() ? "&q=" + encodeURIComponent(q.value.trim()) : "");
    fetch(url, { headers: { Accept: "application/json" }, credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (j) {
      var cur = sel.dataset.current, curTitle = sel.dataset.currentTitle, found = false;
      sel.innerHTML = "<option value=''>" + i18n.choose + "</option>";
      (j.items || []).forEach(function (d) { var o = document.createElement("option"); o.value = d.id; o.textContent = d.title; if (d.id === cur) { o.selected = true; found = true; } sel.appendChild(o); });
      if (cur && !found && curTitle) { var o = document.createElement("option"); o.value = cur; o.textContent = curTitle; o.selected = true; sel.insertBefore(o, sel.children[1]); }
      status.textContent = j.error ? (i18n.failed + ": " + j.error) : i18n.count.replace("{n}", (j.items || []).length);
    }).catch(function () { status.textContent = i18n.failed; });
  }
  prov.addEventListener("change", function () { sel.dataset.current = ""; sel.dataset.currentTitle = ""; titleIn.value = ""; q.value = ""; loadDramas(); });
  q.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(loadDramas, 400); });
  sel.addEventListener("change", function () { titleIn.value = sel.selectedOptions[0] ? sel.selectedOptions[0].textContent : ""; });
  if (prov.value) loadDramas();

  var preset = box.querySelector("[data-ap-interval-preset]"), minutes = box.querySelector('[name="auto_post[interval_minutes]"]');
  preset.addEventListener("change", function () { if (preset.value) minutes.value = preset.value; });
})();
</script>
