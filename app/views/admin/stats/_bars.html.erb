<%# Daftar batang horizontal: rows = [[label, count]], pct = lambda persen dari total. %>
<% max = [ rows.map(&:last).max.to_i, 1 ].max %>
<ul class="bars">
  <% rows.each do |label, n| %>
    <li>
      <span class="bars-label truncate" title="<%= label %>"><%= label %></span>
      <span class="bars-track"><span class="bars-fill" style="width:<%= (n * 100.0 / max).round(1) %>%"></span></span>
      <span class="bars-num"><%= number_with_delimiter(n, delimiter: ".") %> <em><%= pct.(n) %></em></span>
    </li>
  <% end %>
</ul>
