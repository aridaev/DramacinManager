<%# Shell admin 3 kolom: sidebar (drawer di < lg) · konten · panel kanan "status & aktivitas" (di < xl turun ke bawah konten).
    Halaman bisa mengganti isi panel dengan content_for :panel, atau menyembunyikannya dengan locals panel: false.
    Kerapatan (compact/comfortable) disimpan di localStorage "dm_density" dan dipasang ke <html data-density>. %>
<% nav_groups = [
  [ :group_main, [
    { key: :dashboard, path: root_path, icon: "layout-dashboard", active: current_page?(root_path) },
    ((admin? || Setting.users_can_create_instances?) ? { key: :instances, path: admin_instances_path, icon: "box", active: request.path.start_with?(admin_instances_path) } : nil)
  ] ],
  (admin? ? [ :group_admin, [
    { key: :admin, path: admin_root_path, icon: "shield-check", active: current_page?(admin_root_path) },
    { key: :providers, path: admin_providers_path, icon: "layers", active: request.path.start_with?(admin_providers_path) || request.path.include?("custom_providers") },
    { key: :site_settings, path: edit_admin_site_settings_path, icon: "settings-2", active: request.path.start_with?("/admin/site_settings") },
    { key: :api_sources, path: admin_api_sources_path, icon: "plug-zap", active: request.path.start_with?(admin_api_sources_path) || current_page?(edit_admin_settings_path) }
  ] ] : nil),
  [ :group_account, [
    { key: :account, path: edit_user_registration_path, icon: "user-round", active: current_page?(edit_user_registration_path) }
  ] ]
].compact %>
<% show_panel = local_assigns.fetch(:panel, true) %>

<div class="app min-h-screen bg-[var(--bg)] lg:flex lg:items-start" id="app">
  <a class="skip-link" href="#main"><%= t("nav.skip") %></a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle peer" hidden>

  <%# ---------- Kolom 1: sidebar ---------- %>
  <aside class="sidebar fixed inset-y-0 left-0 z-40 flex w-72 max-w-[85vw] -translate-x-full flex-col border-r border-[var(--border)] bg-white transition-transform duration-200 peer-checked:translate-x-0 overflow-hidden lg:sticky lg:top-0 lg:h-screen lg:w-64 lg:translate-x-0 lg:shrink-0" aria-label="<%= t("nav.main_menu") %>">
    <div class="flex items-center gap-3 px-5 pt-5 pb-4">
      <span class="brand-mark">D</span>
      <div class="brand-lockup min-w-0">
        <strong class="truncate"><%= t("app.name") %></strong>
        <span class="truncate"><%= t("app.tagline") %></span>
      </div>
      <label for="nav-toggle" class="icon-btn ml-auto lg:hidden" aria-label="<%= t("nav.close") %>"><%= dm_icon("x", size: 18) %></label>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 pb-3">
      <% nav_groups.each do |(group, items)| %>
        <div class="side-group"><%= t("nav.#{group}") %></div>
        <% items.compact.each do |item| %>
          <%= link_to item[:path], class: ["side-link", ("is-active" if item[:active])], aria: { current: (item[:active] ? "page" : nil) } do %>
            <%= dm_icon(item[:icon], size: 18) %>
            <span class="truncate"><%= t("nav.#{item[:key]}") %></span>
          <% end %>
        <% end %>
      <% end %>
      <div class="side-group"><%= t("nav.group_site") %></div>
      <%= link_to template_v1_root_path, class: "side-link", target: "_blank", rel: "noopener" do %>
        <%= dm_icon("external-link", size: 18) %>
        <span class="truncate"><%= t("nav.open_template") %></span>
      <% end %>
    </nav>

    <div class="border-t border-[var(--border)] p-4 grid gap-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <%= render "shared/locale_switcher" %>
        <div class="density" role="group" aria-label="<%= t("nav.density") %>">
          <button type="button" class="density-btn" data-density="comfortable"><%= t("nav.comfortable") %></button>
          <button type="button" class="density-btn" data-density="compact"><%= t("nav.compact") %></button>
        </div>
      </div>
      <div class="flex items-center gap-2 min-w-0">
        <span class="avatar"><%= current_user.email.to_s[0, 1].upcase %></span>
        <div class="min-w-0 leading-tight">
          <div class="truncate text-[.8rem] font-semibold text-[var(--heading)]" title="<%= current_user.email %>"><%= current_user.email %></div>
          <div class="text-[.72rem] text-[var(--text-muted)]"><%= t("roles.#{current_user.role}", default: current_user.role.to_s) %></div>
        </div>
        <%= button_to destroy_user_session_path, method: :delete, class: "icon-btn ml-auto", title: t("nav.sign_out"), form: { class: "m-0" } do %><%= dm_icon("log-out", size: 16) %><% end %>
      </div>
    </div>
  </aside>
  <label for="nav-toggle" class="nav-backdrop fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-[1px] peer-checked:block lg:hidden" aria-hidden="true"></label>

  <%# ---------- Kolom 2 + 3 ---------- %>
  <div class="app-main flex min-w-0 flex-1 flex-col min-h-screen">
    <header class="topbar sticky top-0 z-20 border-b border-[var(--border)] bg-white/85 backdrop-blur">
      <div class="mx-auto flex w-full max-w-[var(--page-max)] flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:px-6">
        <label for="nav-toggle" class="icon-btn lg:hidden" aria-label="<%= t("nav.main_menu") %>"><%= dm_icon("menu", size: 20) %></label>
        <div class="topbar-title min-w-0 flex-1">
          <h1 class="truncate"><%= title %></h1>
          <% if local_assigns[:subtitle].present? %><p class="truncate"><%= subtitle %></p><% end %>
        </div>
        <div class="topbar-actions flex w-full flex-wrap items-center gap-2 sm:w-auto"><%= yield :page_actions %></div>
      </div>
    </header>

    <div class="mx-auto grid w-full max-w-[var(--page-max)] flex-1 grid-cols-[minmax(0,1fr)] gap-6 px-4 py-5 sm:px-6 <%= 'xl:grid-cols-[minmax(0,1fr)_300px]' if show_panel %>">
      <main class="page min-w-0" id="main">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
      <% if show_panel %>
        <aside class="panel min-w-0 xl:sticky xl:top-[76px] xl:self-start" aria-label="<%= t("panel.title") %>">
          <% if content_for?(:panel) %><%= yield :panel %><% else %><%= render "shared/app_panel" %><% end %>
        </aside>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.documentElement;
    var cur = (function () { try { return localStorage.getItem("dm_density"); } catch (e) { return null; } })() || "comfortable";
    var apply = function (d) {
      root.setAttribute("data-density", d);
      document.querySelectorAll(".density-btn").forEach(function (b) { b.classList.toggle("is-active", b.dataset.density === d); });
      try { localStorage.setItem("dm_density", d); } catch (e) {}
    };
    apply(cur);
    document.querySelectorAll(".density-btn").forEach(function (b) { b.addEventListener("click", function () { apply(b.dataset.density); }); });
    var t = document.getElementById("nav-toggle");
    document.querySelectorAll(".side-link").forEach(function (a) { a.addEventListener("click", function () { t.checked = false; }); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") t.checked = false; });
  })();
</script>
