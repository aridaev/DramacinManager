<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= current_instance&.theme("theme_default") || "dark" %>">
  <head>
    <meta charset="utf-8">
<%= render "template/v1/shared/seo_head" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= tv1_icon_url %>">
    <script>
      (function () {
        var t = document.documentElement.getAttribute("data-theme") || "dark";
        try { var v = localStorage.getItem("tv2_theme"); if (v === "light" || v === "dark") t = v; } catch (e) {}
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;900&display=swap">
    <%= stylesheet_link_tag "template/v2" %>
    <% if current_instance %>
      <% if (href = current_instance.theme_font_href) %><link rel="stylesheet" href="<%= href %>"><% end %>
      <style id="tv1-instance-theme"><%= current_instance.theme_css.html_safe %></style>
    <% end %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="tv2">
    <% if current_instance && !on_instance_host? %>
      <div class="preview-bar">
        <span><%= t("template.v1.preview_bar", name: current_instance.display_name) %></span>
        <%= link_to t("template.v1.preview_exit"), template_v1_root_path(preview_instance: 0), class: "preview-bar-exit" %>
      </div>
    <% end %>

    <div class="shell">
      <aside class="sidebar" id="tv2-sidebar">
        <div class="sidebar-head">
          <%= link_to template_v1_root_path, class: "brand" do %>
            <% if tv1_logo_url %><%= image_tag tv1_logo_url, alt: tv1_site_name, class: "brand-logo" %><% else %><span class="brand-name"><%= tv1_site_name %></span><% end %>
          <% end %>
          <button type="button" class="icon-btn sidebar-close" id="tv2-close" aria-label="close">✕</button>
        </div>

        <%= form_with url: template_v1_search_path, method: :get, class: "side-search", data: { turbo: false } do |f| %>
          <%= hidden_field_tag :provider, current_provider&.slug %>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <%= f.search_field :q, value: params[:q], placeholder: tt("search_placeholder"), autocomplete: "off", aria: { label: tt("search") } %>
        <% end %>

        <nav class="side-nav" aria-label="main">
          <% if tv1_nav_items.any? %>
            <% tv1_nav_items.each do |it| %>
              <% children = Array(it["children"]).select { |c| c["enabled"] != false } %>
              <% if children.any? %>
                <details class="side-group"<%= " open" if children.any? { |c| current_page?(tv1_nav_url(c["url"])) } %>>
                  <summary><%= tv2_nav_icon(it["url"]) %><span><%= it["label"] %></span></summary>
                  <div class="side-sub">
                    <% children.each do |ch| %><%= link_to ch["label"], tv1_nav_url(ch["url"]), class: ["side-sub-link", ("is-active" if current_page?(tv1_nav_url(ch["url"])))], target: (ch["new_tab"] ? "_blank" : nil), rel: (ch["new_tab"] ? "noopener" : nil) %><% end %>
                  </div>
                </details>
              <% else %>
                <%= link_to tv1_nav_url(it["url"]), class: ["side-link", ("is-active" if current_page?(tv1_nav_url(it["url"])))], target: (it["new_tab"] ? "_blank" : nil), rel: (it["new_tab"] ? "noopener" : nil) do %><%= tv2_nav_icon(it["url"]) %><span><%= it["label"] %></span><% end %>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to template_v1_root_path, class: ["side-link", ("is-active" if current_page?(template_v1_root_path))] do %><%= tv2_nav_icon("/") %><span><%= tt("nav.home") %></span><% end %>
            <%= link_to template_v1_latest_path, class: ["side-link", ("is-active" if current_page?(template_v1_latest_path))] do %><%= tv2_nav_icon("/latest") %><span><%= tt("nav.collection") %></span><% end %>
            <details class="side-group"<%= " open" if request.path.include?("/genre") %>>
              <summary><%= tv2_nav_icon("/genre") %><span><%= tt("nav.genre") %></span></summary>
              <div class="side-sub">
                <% ::Template::V1::BaseController::GENRES.each do |g| %><%= link_to t("template.v1.genres.#{g}", default: g.titleize), template_v1_genre_path(g), class: "side-sub-link" %><% end %>
              </div>
            </details>
          <% end %>
        </nav>

        <div class="side-foot">
          <% if enabled_providers.any? %>
            <%= form_with url: template_v1_root_path, method: :get, class: "side-provider", data: { turbo: false } do |f| %>
              <label><span class="side-label"><%= tt("provider") %></span>
                <%= select_tag :provider, options_from_collection_for_select(enabled_providers, :slug, :name, current_provider&.slug), data: { autosubmit: true }, aria: { label: tt("provider") } %>
              </label>
            <% end %>
          <% end %>
          <div class="side-row">
            <details class="side-lang">
              <summary><%= I18n.locale.to_s.upcase %></summary>
              <div class="side-lang-panel"><% I18n.available_locales.each do |loc| %><%= link_to t("locales.#{loc}"), url_for(locale: loc), class: ("is-active" if I18n.locale == loc) %><% end %></div>
            </details>
            <button type="button" class="icon-btn" id="tv1-theme-toggle" aria-label="<%= tt('toggle_theme') %>">
              <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
            </button>
          </div>
        </div>
      </aside>
      <div class="sidebar-backdrop" id="tv2-backdrop"></div>

      <div class="content">
        <header class="mobile-top">
          <button type="button" class="icon-btn" id="tv2-burger" aria-label="Menu" aria-controls="tv2-sidebar" aria-expanded="false"><span class="burger"><i></i><i></i><i></i></span></button>
          <%= link_to template_v1_root_path, class: "brand" do %>
            <% if tv1_logo_url %><%= image_tag tv1_logo_url, alt: tv1_site_name, class: "brand-logo" %><% else %><span class="brand-name"><%= tv1_site_name %></span><% end %>
          <% end %>
          <%= link_to template_v1_search_path, class: "icon-btn", aria: { label: tt("search") } do %><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><% end %>
        </header>

        <main class="main">
          <%= yield %>
        </main>

        <footer class="site-footer">
          <div class="footer-grid">
            <div class="footer-brand">
              <%= link_to template_v1_root_path, class: "brand" do %>
                <% if tv1_logo_url %><%= image_tag tv1_logo_url, alt: tv1_site_name, class: "brand-logo" %><% else %><span class="brand-name"><%= tv1_site_name %></span><% end %>
              <% end %>
              <p><%= tv1_footer_text %></p>
              <% if current_instance&.footer_about.present? %><p class="footer-about"><%= simple_format(current_instance.footer_about, {}, wrapper_tag: "span") %></p><% end %>
            </div>
            <div class="footer-col">
              <h4><%= tt("footer.explore") %></h4>
              <%= link_to tt("nav.home"), template_v1_root_path %>
              <%= link_to tt("nav.collection"), template_v1_latest_path %>
              <%= link_to tt("nav.genre"), template_v1_genres_path %>
            </div>
            <div class="footer-col">
              <h4><%= tt("footer.popular_genres") %></h4>
              <% ::Template::V1::BaseController::GENRES.first(6).each do |g| %><%= link_to t("template.v1.genres.#{g}", default: g.titleize), template_v1_genre_path(g) %><% end %>
            </div>
            <% if tv1_footer_links.any? || current_instance&.social_links&.any? %>
              <div class="footer-col">
                <h4><%= tt("footer.info") %></h4>
                <% current_instance.footer_link_items.each do |it| %><%= link_to it["label"], tv1_nav_url(it["url"]), target: (it["new_tab"] ? "_blank" : nil), rel: (it["new_tab"] ? "noopener" : nil) %><% end %>
                <% if current_instance.social_links.any? %><div class="footer-social"><% current_instance.social_links.each do |sl| %><%= link_to sl["name"], sl["url"], target: "_blank", rel: "noopener", class: "social-btn", style: "--sc:#{sl['color']}" %><% end %></div><% end %>
              </div>
            <% end %>
          </div>
          <div class="footer-bottom">
            <span><% if tv1_copyright %><%= tv1_copyright %><% else %>© <%= Date.current.year %> <%= tv1_site_name %>. <%= tt("footer.rights") %><% end %></span>
            <% show_prov = current_instance.nil? || current_instance.footer_show_providers?; show_pow = current_instance.nil? || current_instance.footer_show_powered? %>
            <% if show_prov || show_pow %><span class="muted"><% if show_prov %><%= t("template.v1.footer.providers", count: enabled_providers.size) %><% end %><% if show_prov && show_pow %> · <% end %><% if show_pow %><%= t("template.v1.footer.powered") %><% end %></span><% end %>
          </div>
          <%= render "template/v1/shared/provider_links" %>
        </footer>
      </div>
    </div>

    <script>
      (function () {
        var html = document.documentElement, burger = document.getElementById("tv2-burger");
        function setMenu(o) { html.classList.toggle("side-open", o); burger.setAttribute("aria-expanded", o ? "true" : "false"); }
        burger.addEventListener("click", function () { setMenu(!html.classList.contains("side-open")); });
        document.getElementById("tv2-close").addEventListener("click", function () { setMenu(false); });
        document.getElementById("tv2-backdrop").addEventListener("click", function () { setMenu(false); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") setMenu(false); });
        document.querySelectorAll(".side-nav a").forEach(function (a) { a.addEventListener("click", function () { setMenu(false); }); });
        var btn = document.getElementById("tv1-theme-toggle");
        if (btn) btn.addEventListener("click", function () {
          var next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
          html.setAttribute("data-theme", next); try { localStorage.setItem("tv2_theme", next); } catch (e) {}
        });
        document.querySelectorAll("[data-autosubmit]").forEach(function (el) { el.addEventListener("change", function () { el.form.submit(); }); });
        // rail: tombol geser
        document.querySelectorAll("[data-rail]").forEach(function (rail) {
          var track = rail.querySelector(".rail-track");
          rail.querySelectorAll("[data-rail-nav]").forEach(function (b) {
            b.addEventListener("click", function () { track.scrollBy({ left: track.clientWidth * 0.8 * (b.dataset.railNav === "next" ? 1 : -1), behavior: "smooth" }); });
          });
        });
        // hero slider auto
        var hero = document.getElementById("tv2-hero");
        if (hero) {
          var slides = hero.querySelectorAll(".hero-slide"), dots = hero.querySelectorAll(".hero-dot"), i = 0, timer;
          function go(n) { slides[i].classList.remove("is-on"); dots[i].classList.remove("is-on"); i = (n + slides.length) % slides.length; slides[i].classList.add("is-on"); dots[i].classList.add("is-on"); }
          function auto() { clearInterval(timer); timer = setInterval(function () { go(i + 1); }, 6000); }
          dots.forEach(function (d, n) { d.addEventListener("click", function () { go(n); auto(); }); });
          hero.querySelectorAll("[data-hero-nav]").forEach(function (b) { b.addEventListener("click", function () { go(i + (b.dataset.heroNav === "next" ? 1 : -1)); auto(); }); });
          if (slides.length > 1) auto();
        }
        // lazy section + load more (sama seperti v1)
        var mount = function (slot) { var tpl = slot.querySelector("template"); if (!tpl) return; slot.replaceWith(tpl.content.cloneNode(true)); wire(); };
        var slots = document.querySelectorAll("[data-lazy-slot]");
        if ("IntersectionObserver" in window) { var io = new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); mount(en.target); } }); }, { rootMargin: "600px 0px" }); slots.forEach(function (s) { io.observe(s); }); } else slots.forEach(mount);
        function wire() {
          document.querySelectorAll("[data-load-more]:not([data-wired])").forEach(function (b) {
            b.dataset.wired = "1";
            b.addEventListener("click", function () { var sec = b.closest("[data-lazy-section]"), tpl = sec.querySelector("[data-more-items]"); if (tpl) sec.querySelector(".grid").appendChild(tpl.content.cloneNode(true)); b.closest(".section-more").remove(); });
          });
        }
        wire();
      })();
    </script>
    <%= render "template/v1/shared/mobile_tabs" %>
    <%= render "template/v1/shared/img_fallback" %>
    <%= render "template/v1/shared/source_guard" %>
    <%= yield :scripts %>
  </body>
</html>
