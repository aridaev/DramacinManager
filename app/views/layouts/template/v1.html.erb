<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= current_instance&.theme("theme_default") || "dark" %>">
  <head>
    <meta charset="utf-8">
<%= render "template/v1/shared/seo_head" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= tv1_icon_url %>">
    <script>
      (function () {
        var t = document.documentElement.getAttribute("data-theme") || "dark";
        try { var v = localStorage.getItem("tv1_theme"); if (v === "light" || v === "dark") t = v; } catch (e) {}
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <%= stylesheet_link_tag "template/v1" %>
    <% if current_instance %>
      <% if (href = current_instance.theme_font_href) %><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="<%= href %>"><% end %>
      <style id="tv1-instance-theme"><%= current_instance.theme_css.html_safe %></style>
    <% end %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="tv1">
    <% if current_instance && !on_instance_host? %>
      <div class="preview-bar">
        <span><%= t("template.v1.preview_bar", name: current_instance.display_name) %></span>
        <%= link_to t("template.v1.preview_exit"), template_v1_root_path(preview_instance: 0), class: "preview-bar-exit" %>
      </div>
    <% end %>
    <header class="topbar">
      <div class="topbar-inner">
        <%= link_to template_v1_root_path, class: "brand" do %>
          <% if tv1_logo_url %>
            <%= image_tag tv1_logo_url, alt: tv1_site_name, class: "brand-logo" %>
          <% else %>
            <span class="brand-mark"><%= tv1_site_name.to_s[0, 1].upcase %></span>
            <span class="brand-name"><%= tv1_site_name %></span>
          <% end %>
        <% end %>

        <%= form_with url: template_v1_search_path, method: :get, class: "global-search", data: { turbo: false } do |f| %>
          <%= hidden_field_tag :provider, current_provider&.slug %>
          <%= f.search_field :q, value: params[:q], placeholder: t("template.v1.search_placeholder"), class: "global-search-input", autocomplete: "off", aria: { label: t("template.v1.search") } %>
          <button type="submit" class="global-search-btn" aria-label="<%= t('template.v1.search') %>">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
        <% end %>

        <%= render "template/v1/shared/adfree_nav" %>

        <button type="button" class="menu-burger" id="tv1-burger" aria-controls="site-menu" aria-expanded="false" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="menu" id="site-menu">
          <% if tv1_nav_items.any? %>
            <% tv1_nav_items.each do |it| %>
              <% children = Array(it["children"]).select { |c| c["enabled"] != false } %>
              <% if children.any? %>
                <details class="menu-dropdown">
                  <summary><%= it["label"] %></summary>
                  <div class="menu-dropdown-panel">
                    <% children.each do |ch| %>
                      <%= link_to ch["label"], tv1_nav_url(ch["url"]), class: "menu-dropdown-item", target: (ch["new_tab"] ? "_blank" : nil), rel: (ch["new_tab"] ? "noopener" : nil) %>
                    <% end %>
                  </div>
                </details>
              <% else %>
                <%= link_to it["label"], tv1_nav_url(it["url"]), class: ["menu-link", ("is-active" if current_page?(tv1_nav_url(it["url"])))], target: (it["new_tab"] ? "_blank" : nil), rel: (it["new_tab"] ? "noopener" : nil) %>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to t("template.v1.nav.home"), template_v1_root_path, class: ["menu-link", ("is-active" if current_page?(template_v1_root_path))] %>
            <details class="menu-dropdown">
              <summary><%= t("template.v1.nav.genre") %></summary>
              <div class="menu-dropdown-panel">
                <% ::Template::V1::BaseController::GENRES.each do |g| %>
                  <%= link_to t("template.v1.genres.#{g}", default: g.titleize), template_v1_genre_path(g), class: "menu-dropdown-item" %>
                <% end %>
              </div>
            </details>
          <% end %>
          <details class="menu-dropdown">
            <summary><%= t("template.v1.nav.language") %></summary>
            <div class="menu-dropdown-panel">
              <% I18n.available_locales.each do |loc| %>
                <%= link_to t("locales.#{loc}"), url_for(locale: loc), class: ["menu-dropdown-item", ("is-active" if I18n.locale == loc)] %>
              <% end %>
            </div>
          </details>
          <% if user_signed_in? && !on_instance_host? %>
            <%= link_to t("template.v1.nav.manage"), root_path, class: "menu-link menu-link-ghost" %>
          <% end %>
          <button type="button" class="theme-btn" id="tv1-theme-toggle" aria-label="<%= t('template.v1.toggle_theme') %>">
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          </button>
        </nav>
      </div>

      <%= render "template/v1/shared/provider_bar" %>
    </header>

    <main class="container">
      <% if flash[:notice].present? || flash[:alert].present? %><div class="tv1-flash <%= flash[:alert].present? ? 'is-alert' : '' %>" role="status"><%= flash[:alert].presence || flash[:notice] %></div><% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <%= link_to template_v1_root_path, class: "brand" do %>
              <% if tv1_logo_url %><%= image_tag tv1_logo_url, alt: tv1_site_name, class: "brand-logo" %><% else %><span class="brand-mark"><%= tv1_site_name.to_s[0, 1].upcase %></span><span class="brand-name"><%= tv1_site_name %></span><% end %>
            <% end %>
            <p><%= tv1_footer_text %></p>
            <% if (about = current_instance&.localized("footer_about")).present? %><p class="muted footer-about"><%= simple_format(about, {}, wrapper_tag: "span") %></p><% end %>
          </div>
          <% if tv1_footer_links.any? %>
            <nav class="footer-links" aria-label="footer">
              <% current_instance.footer_link_items.each do |it| %>
                <%= link_to it["label"], tv1_nav_url(it["url"]), target: (it["new_tab"] ? "_blank" : nil), rel: (it["new_tab"] ? "noopener" : nil) %>
              <% end %>
            </nav>
          <% end %>
          <% if current_instance&.social_links&.any? %>
            <div class="footer-social">
              <% current_instance.social_links.each do |sl| %>
                <%= link_to sl["name"], sl["url"], target: "_blank", rel: "noopener", class: "social-btn", style: "--sc:#{sl['color']}" %>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="footer-bottom">
          <% if tv1_copyright %><span><%= tv1_copyright %></span><% else %><span>© <%= Date.current.year %> <%= tv1_site_name %></span><% end %>
          <% show_prov = current_instance.nil? || current_instance.footer_show_providers?; show_pow = current_instance.nil? || current_instance.footer_show_powered? %>
          <% if show_prov || show_pow %>
            <span class="muted"><% if show_prov %><%= t("template.v1.footer.providers", count: enabled_providers.size) %><% end %><% if show_prov && show_pow %> · <% end %><% if show_pow %><%= t("template.v1.footer.powered") %><% end %></span>
          <% end %>
        </div>
      </div>
      <%= render "template/v1/shared/provider_links" %>
    </footer>

    <script>
      (function () {
        var burger = document.getElementById("tv1-burger"), menu = document.getElementById("site-menu");
        function setMenu(open) {
          document.documentElement.classList.toggle("menu-open", open);
          burger.setAttribute("aria-expanded", open ? "true" : "false");
          if (!open) menu.querySelectorAll("details[open]").forEach(function (d) { d.removeAttribute("open"); });
        }
        if (burger && menu) {
          burger.addEventListener("click", function (e) { e.stopPropagation(); setMenu(!document.documentElement.classList.contains("menu-open")); });
          document.addEventListener("click", function (e) { if (document.documentElement.classList.contains("menu-open") && !menu.contains(e.target)) setMenu(false); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape") setMenu(false); });
          menu.addEventListener("click", function (e) { if (e.target.closest("a")) setMenu(false); });
          window.addEventListener("resize", function () { if (window.innerWidth > 860) setMenu(false); });
        }
        var btn = document.getElementById("tv1-theme-toggle");
        if (btn) btn.addEventListener("click", function () {
          var next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("tv1_theme", next); } catch (e) {}
        });
        document.querySelectorAll("[data-autosubmit]").forEach(function (el) {
          el.addEventListener("change", function () { el.form.submit(); });
        });
        // Lazy load section: pasang isi <template> saat slot mendekati viewport.
        var mount = function (slot) {
          var tpl = slot.querySelector("template");
          if (!tpl) return;
          slot.replaceWith(tpl.content.cloneNode(true));
          wireLoadMore();
        };
        var slots = document.querySelectorAll("[data-lazy-slot]");
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); mount(en.target); } });
          }, { rootMargin: "600px 0px" });
          slots.forEach(function (s) { io.observe(s); });
        } else {
          slots.forEach(mount);
        }
        function wireLoadMore() {
          document.querySelectorAll("[data-load-more]:not([data-wired])").forEach(function (btn) {
            btn.dataset.wired = "1";
            btn.addEventListener("click", function () {
              var sec = btn.closest("[data-lazy-section]");
              var tpl = sec.querySelector("[data-more-items]");
              if (tpl) sec.querySelector(".grid").appendChild(tpl.content.cloneNode(true));
              btn.closest(".section-more").remove();
            });
          });
        }
        wireLoadMore();
        var track = document.getElementById("hero-track");
        if (track) {
          var step = function () { var card = track.querySelector(".hero-card"); return card ? card.getBoundingClientRect().width + 16 : track.clientWidth; };
          document.querySelectorAll("[data-hero-nav]").forEach(function (b) {
            b.addEventListener("click", function () { track.scrollBy({ left: step() * (b.dataset.heroNav === "next" ? 1 : -1), behavior: "smooth" }); });
          });
        }
      })();
    </script>
    <%= render "template/v1/shared/mobile_tabs" %>
    <%= render "template/v1/shared/img_fallback" %>
    <%= render "template/v1/shared/source_guard" %>
    <%= yield :scripts %>
  </body>
</html>
