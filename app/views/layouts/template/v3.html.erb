<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= current_instance&.theme("theme_default").presence || "light" %>">
  <head>
    <meta charset="utf-8">
<%= render "template/v1/shared/seo_head" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= tv1_icon_url %>">
    <script>
      (function () {
        var t = document.documentElement.getAttribute("data-theme") || "light";
        try { var v = localStorage.getItem("tv3_theme"); if (v === "light" || v === "dark") t = v; } catch (e) {}
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <%= stylesheet_link_tag "template/v3" %>
    <% if current_instance %>
      <% if (href = current_instance.theme_font_href) %><link rel="stylesheet" href="<%= href %>"><% end %>
      <style id="tv1-instance-theme"><%= current_instance.theme_css.html_safe %></style>
    <% end %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="tv3">
    <% if current_instance && !on_instance_host? %>
      <div class="preview-bar">
        <span><%= t("template.v1.preview_bar", name: current_instance.display_name) %></span>
        <%= link_to t("template.v1.preview_exit"), template_v1_root_path(preview_instance: 0), class: "preview-bar-exit" %>
      </div>
    <% end %>

    <header class="header">
      <div class="header-top wrap">
        <button type="button" class="icon-btn burger-btn" id="tv3-burger" aria-label="Menu" aria-controls="tv3-menu" aria-expanded="false"><span class="burger"><i></i><i></i><i></i></span></button>
        <%= link_to template_v1_root_path, class: "brand" do %>
          <% if tv1_logo_url %><%= image_tag tv1_logo_url, alt: tv1_site_name, class: "brand-logo" %><% else %><span class="brand-mark" aria-hidden="true"></span><span class="brand-name"><%= tv1_site_name %></span><% end %>
        <% end %>

        <%= form_with url: template_v1_search_path, method: :get, class: "search", data: { turbo: false } do |f| %>
          <%= hidden_field_tag :provider, current_provider&.slug %>
          <%= f.search_field :q, value: params[:q], placeholder: tt("search_placeholder"), autocomplete: "off", aria: { label: tt("search") } %>
          <button type="submit" class="search-btn" aria-label="<%= tt('search') %>"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
        <% end %>

        <div class="header-tools">
          <% if enabled_providers.any? %>
            <%= form_with url: template_v1_root_path, method: :get, class: "provider-form", data: { turbo: false } do |f| %>
              <%= select_tag :provider, options_from_collection_for_select(enabled_providers, :slug, :name, current_provider&.slug), class: "tool-select", data: { autosubmit: true }, aria: { label: tt("provider") } %>
            <% end %>
          <% end %>
          <details class="lang">
            <summary><%= I18n.locale.to_s.upcase %></summary>
            <div class="lang-panel"><% I18n.available_locales.each do |loc| %><%= link_to t("locales.#{loc}"), url_for(locale: loc), class: ("is-active" if I18n.locale == loc) %><% end %></div>
          </details>
          <button type="button" class="icon-btn" id="tv1-theme-toggle" aria-label="<%= tt('toggle_theme') %>">
            <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          </button>
        </div>
      </div>

      <nav class="channels wrap" id="tv3-menu" aria-label="main">
        <div class="channels-track">
          <% if tv1_nav_items.any? %>
            <% tv1_nav_items.each do |it| %>
              <% children = Array(it["children"]).select { |c| c["enabled"] != false } %>
              <% if children.any? %>
                <details class="chan-group">
                  <summary class="chan"><%= it["label"] %> <i class="caret"></i></summary>
                  <div class="chan-sub"><% children.each do |ch| %><%= link_to ch["label"], tv1_nav_url(ch["url"]), target: (ch["new_tab"] ? "_blank" : nil), rel: (ch["new_tab"] ? "noopener" : nil) %><% end %></div>
                </details>
              <% else %>
                <%= link_to it["label"], tv1_nav_url(it["url"]), class: ["chan", ("is-active" if current_page?(tv1_nav_url(it["url"])))], target: (it["new_tab"] ? "_blank" : nil), rel: (it["new_tab"] ? "noopener" : nil) %>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to tt("nav.home"), template_v1_root_path, class: ["chan", ("is-active" if current_page?(template_v1_root_path))] %>
            <%= link_to tt("nav.latest"), template_v1_latest_path, class: ["chan", ("is-active" if current_page?(template_v1_latest_path))] %>
            <% ::Template::V1::BaseController::GENRES.each do |g| %><%= link_to t("template.v1.genres.#{g}", default: g.titleize), template_v1_genre_path(g), class: ["chan", ("is-active" if current_page?(template_v1_genre_path(g)))] %><% end %>
            <%= link_to tt("nav.genre"), template_v1_genres_path, class: ["chan", ("is-active" if current_page?(template_v1_genres_path))] %>
          <% end %>
        </div>
      </nav>
    </header>
    <div class="menu-backdrop" id="tv3-backdrop"></div>

    <main class="main wrap">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-links">
          <%= link_to tt("nav.home"), template_v1_root_path %>
          <%= link_to tt("nav.latest"), template_v1_latest_path %>
          <%= link_to tt("nav.genre"), template_v1_genres_path %>
          <% if current_instance %><% current_instance.footer_link_items.each do |it| %><%= link_to it["label"], tv1_nav_url(it["url"]), target: (it["new_tab"] ? "_blank" : nil), rel: (it["new_tab"] ? "noopener" : nil) %><% end %><% end %>
        </div>
        <% if current_instance&.social_links&.any? %><div class="footer-social"><% current_instance.social_links.each do |sl| %><%= link_to sl["name"], sl["url"], target: "_blank", rel: "noopener", class: "social-btn", style: "--sc:#{sl['color']}" %><% end %></div><% end %>
        <p class="footer-text"><%= tv1_footer_text %></p>
        <% if current_instance&.footer_about.present? %><p class="footer-about"><%= simple_format(current_instance.footer_about, {}, wrapper_tag: "span") %></p><% end %>
        <p class="footer-copy">
          <% if tv1_copyright %><%= tv1_copyright %><% else %>© <%= Date.current.year %> <%= tv1_site_name %><% end %>
          <% show_prov = current_instance.nil? || current_instance.footer_show_providers?; show_pow = current_instance.nil? || current_instance.footer_show_powered? %>
          <% if show_prov %> · <%= t("template.v1.footer.providers", count: enabled_providers.size) %><% end %><% if show_pow %> · <%= t("template.v1.footer.powered") %><% end %>
        </p>
      </div>
      <%= render "template/v1/shared/provider_links" %>
    </footer>

    <script>
      (function () {
        var html = document.documentElement, burger = document.getElementById("tv3-burger"), menu = document.getElementById("tv3-menu");
        function setMenu(o) { html.classList.toggle("menu-open", o); burger.setAttribute("aria-expanded", o ? "true" : "false"); }
        burger.addEventListener("click", function (e) { e.stopPropagation(); setMenu(!html.classList.contains("menu-open")); });
        document.getElementById("tv3-backdrop").addEventListener("click", function () { setMenu(false); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") setMenu(false); });
        menu.addEventListener("click", function (e) { if (e.target.closest("a")) setMenu(false); });
        window.addEventListener("resize", function () { if (window.innerWidth > 860) setMenu(false); });
        var act = menu.querySelector(".chan.is-active"); if (act && act.scrollIntoView) act.scrollIntoView({ block: "nearest", inline: "center" });
        var btn = document.getElementById("tv1-theme-toggle");
        if (btn) btn.addEventListener("click", function () {
          var next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
          html.setAttribute("data-theme", next); try { localStorage.setItem("tv3_theme", next); } catch (e) {}
        });
        document.querySelectorAll("[data-autosubmit]").forEach(function (el) { el.addEventListener("change", function () { el.form.submit(); }); });
        // banner swiper
        var sw = document.getElementById("tv3-banner");
        if (sw) {
          var track = sw.querySelector(".banner-track"), slides = track.children, dots = sw.querySelectorAll(".banner-dot"), i = 0, timer;
          function go(n) { i = (n + slides.length) % slides.length; track.scrollTo({ left: slides[i].offsetLeft, behavior: "smooth" }); dots.forEach(function (d, k) { d.classList.toggle("is-on", k === i); }); }
          function auto() { clearInterval(timer); timer = setInterval(function () { go(i + 1); }, 5000); }
          dots.forEach(function (d, n) { d.addEventListener("click", function () { go(n); auto(); }); });
          sw.querySelectorAll("[data-banner-nav]").forEach(function (b) { b.addEventListener("click", function () { go(i + (b.dataset.bannerNav === "next" ? 1 : -1)); auto(); }); });
          var st; track.addEventListener("scroll", function () { clearTimeout(st); st = setTimeout(function () { var k = Math.round(track.scrollLeft / slides[0].offsetWidth); if (k !== i && slides[k]) { i = k; dots.forEach(function (d, m) { d.classList.toggle("is-on", m === i); }); } }, 80); });
          sw.addEventListener("mouseenter", function () { clearInterval(timer); }); sw.addEventListener("mouseleave", auto);
          if (slides.length > 1) auto();
        }
        document.querySelectorAll("[data-rail]").forEach(function (rail) {
          var t = rail.querySelector(".rail-track");
          rail.querySelectorAll("[data-rail-nav]").forEach(function (b) { b.addEventListener("click", function () { t.scrollBy({ left: t.clientWidth * 0.8 * (b.dataset.railNav === "next" ? 1 : -1), behavior: "smooth" }); }); });
        });
        var mount = function (slot) { var tpl = slot.querySelector("template"); if (!tpl) return; slot.replaceWith(tpl.content.cloneNode(true)); wire(); };
        var slots = document.querySelectorAll("[data-lazy-slot]");
        if ("IntersectionObserver" in window) { var io = new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); mount(en.target); } }); }, { rootMargin: "600px 0px" }); slots.forEach(function (s) { io.observe(s); }); } else slots.forEach(mount);
        function wire() {
          document.querySelectorAll("[data-load-more]:not([data-wired])").forEach(function (b) {
            b.dataset.wired = "1";
            b.addEventListener("click", function () { var sec = b.closest("[data-lazy-section]"), tpl = sec.querySelector("[data-more-items]"); if (tpl) sec.querySelector(".grid").appendChild(tpl.content.cloneNode(true)); b.closest(".section-more").remove(); });
          });
        }
        wire();
      })();
    </script>
    <%= render "template/v1/shared/mobile_tabs" %>
    <%= render "template/v1/shared/img_fallback" %>
    <%= render "template/v1/shared/source_guard" %>
    <%= yield :scripts %>
  </body>
</html>
