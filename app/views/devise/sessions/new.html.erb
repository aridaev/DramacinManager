<%= render layout: "shared/auth_card", locals: { title: t("auth.sign_in.title"), subtitle: t("auth.sign_in.subtitle") } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }) do |f| %>
    <div class="field">
      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: t("auth.email_placeholder") %>
    </div>

    <div class="field">
      <div class="field-label-row">
        <%= f.label :password, t("auth.password") %>
        <% if devise_mapping.recoverable? %>
          <%= link_to t("auth.forgot_password"), new_password_path(resource_name) %>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: t("auth.sign_in.password_placeholder") %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="check-row">
        <%= f.check_box :remember_me %>
        <span><%= t("auth.remember_me") %></span>
      </label>
    <% end %>

    <div class="actions">
      <%= f.submit t("auth.sign_in.submit") %>
    </div>
  <% end %>
<% end %>
