<%= render layout: "shared/auth_card", locals: { title: t("auth.forgot.title"), subtitle: t("auth.forgot.subtitle") } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "form" }) do |f| %>
    <div class="field">
      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: t("auth.email_placeholder") %>
    </div>

    <div class="actions">
      <%= f.submit t("auth.forgot.submit") %>
    </div>
  <% end %>
<% end %>
