<%= render layout: "shared/auth_card", locals: { title: t("auth.reset.title"), subtitle: t("auth.reset.subtitle") } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "form" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div class="field">
      <div class="field-label-row">
        <%= f.label :password, t("auth.new_password") %>
        <% if @minimum_password_length %>
          <span class="field-hint"><%= t("auth.min_length", count: @minimum_password_length) %></span>
        <% end %>
      </div>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: t("auth.reset.password_placeholder") %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, t("auth.confirm_new_password") %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t("auth.reset.confirm_placeholder") %>
    </div>

    <div class="actions">
      <%= f.submit t("auth.reset.submit") %>
    </div>
  <% end %>
<% end %>
